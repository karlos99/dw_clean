# Copy to .env and fill in secrets. See instructions.md for deploy notes.

# Django
SECRET_KEY=
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# PostgreSQL
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Seconds to keep DB connections open per worker thread (0 = close after each request).
# Lower values reduce pressure on max_connections; 60 is fine after thread-pool cleanup fixes.
CONN_MAX_AGE=60

# Gunicorn (per django container). Rough PG ceiling ≈ workers × threads per process
# plus up to 8 I/O pool threads per process if many charts render in parallel.
GUNICORN_WORKERS=8
GUNICORN_THREADS=4

# ClickHouse
CLICKHOUSE_HOST=clickhouse
CLICKHOUSE_DB=fastapi_clickhouse_db
CLICKHOUSE_USER=clickhouse_user
CLICKHOUSE_PASSWORD=
USE_CLICKHOUSE_ANALYTICS=True

# Redis
REDIS_URL=redis://redis:6379/0
