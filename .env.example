# Shared DB (same as dw_clean / Django)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=dsdata_prod
POSTGRES_USER=dsdata_user
POSTGRES_PASSWORD=change-me
# Or set DATABASE_URL=postgres://user:pass@host:5432/db

REDIS_URL=redis://localhost:6379/0
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=fastapi_clickhouse_db
CLICKHOUSE_USER=clickhouse_user
CLICKHOUSE_PASSWORD=change-me
USE_CLICKHOUSE_ANALYTICS=true

# API
API_PORT=8080
API_PUBLIC_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
ALLOW_DEV_LOGIN=true

# Google OAuth (same consoles as Django allauth)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
