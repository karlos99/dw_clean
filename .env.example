# Local smoke defaults (scripts/dev_db_setup.sh)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=dw_dev
POSTGRES_USER=dw_dev
POSTGRES_PASSWORD=dw_dev
# Or: DATABASE_URL=postgres://dw_dev:dw_dev@127.0.0.1:5432/dw_dev

# Production / shared dw_clean DB — override the above
# POSTGRES_HOST=postgres
# POSTGRES_DB=dsdata_prod
# POSTGRES_USER=dsdata_user
# POSTGRES_PASSWORD=

REDIS_URL=redis://127.0.0.1:6379/0
CLICKHOUSE_HOST=127.0.0.1
CLICKHOUSE_PORT=8123
CLICKHOUSE_DB=fastapi_clickhouse_db
CLICKHOUSE_USER=clickhouse_user
CLICKHOUSE_PASSWORD=
USE_CLICKHOUSE_ANALYTICS=false

API_PORT=8080
API_PUBLIC_URL=http://localhost:8080
FRONTEND_URL=http://localhost:5173
COOKIE_SECURE=false
ALLOW_DEV_LOGIN=true

# Optional — leave empty to use dev login only
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
