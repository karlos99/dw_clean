{% extends "base.html" %}
{% load static %}

{% block title %}Chart Builder – DataViz{% endblock %}

{% block extra_head %}
<script src="https://cdn.jsdelivr.net/npm/echarts@6.0.0/dist/echarts.min.js"></script>
<style>
  [x-cloak] { display: none !important; }
  .drop-zone { min-height: 2.5rem; transition: background 150ms, border-color 150ms; }
  .drop-zone.drag-over { background-color: #dbeafe !important; border-color: #3b82f6 !important; }
  .column-chip { cursor: grab; user-select: none; transition: all 100ms; }
  .column-chip:active { cursor: grabbing; opacity: 0.7; }
  .chart-type-btn { transition: all 120ms; }
  .chart-type-btn.selected { background-color: #eff6ff; border-color: #3b82f6; box-shadow: 0 0 0 2px #bfdbfe; }
  .chart-type-btn:hover:not(.selected) { background-color: #f8fafc; }
</style>
{% endblock %}

{% block content %}
<div x-data="chartBuilder()" x-cloak class="h-[calc(100vh-5rem)] flex flex-col bg-slate-50">

  {# ── Top bar ─────────────────────────────────────────────────────────── #}
  <div class="flex items-center justify-between bg-white border-b border-slate-200 px-5 py-2.5 flex-shrink-0 shadow-sm">
    <div class="flex items-center gap-3">
      <a href="{% url 'dataviz:index' %}"
         class="flex items-center gap-1 text-slate-500 hover:text-blue-600 text-sm transition">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M15 19l-7-7 7-7"/></svg>
        Charts
      </a>
      <span class="text-slate-300">|</span>
      <input type="text" x-model="name" placeholder="Untitled Chart"
             class="text-base font-semibold text-slate-800 bg-transparent border-0 border-b border-transparent
                    hover:border-slate-300 focus:border-blue-500 focus:ring-0 px-1 py-0.5 w-64 transition"
             :class="!name && 'text-slate-400'">
    </div>
    <div class="flex items-center gap-2">
      <span x-show="saveMsg" x-text="saveMsg" x-transition
            class="text-xs px-2 py-1 rounded"
            :class="saveError ? 'bg-red-50 text-red-600' : 'bg-green-50 text-green-600'"></span>
      <button @click="preview()" :disabled="previewLoading"
              class="px-4 py-2 text-sm bg-white border border-slate-300 hover:bg-slate-50 rounded-lg transition
                     disabled:opacity-50 flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/><path stroke-linecap="round" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"/></svg>
        <span x-text="previewLoading ? 'Loading…' : 'Preview'"></span>
      </button>
      <button @click="save()" :disabled="saving"
              class="px-4 py-2 text-sm bg-blue-600 hover:bg-blue-700 text-white rounded-lg transition
                     disabled:opacity-50 flex items-center gap-1.5">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" d="M8 7H5a2 2 0 00-2 2v9a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-3m-1 4l-3 3m0 0l-3-3m3 3V4"/></svg>
        <span x-text="saving ? 'Saving…' : 'Save'"></span>
      </button>
    </div>
  </div>

  {# ── Main workspace ────────────────────────────────────────────────── #}
  <div class="flex flex-1 overflow-hidden">

    {# ── LEFT PANEL: Data Source + Columns ───────────────────────────── #}
    <div class="w-72 border-r border-slate-200 bg-white flex flex-col overflow-hidden flex-shrink-0">

      {# Source type toggle #}
      <div class="px-4 pt-4 pb-3 border-b border-slate-100">
        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">Data Source</p>
        <div class="flex rounded-lg overflow-hidden border border-slate-200 bg-slate-50">
          <button type="button" @click="sourceType='query'; columns=[]; rawSqlColumns=[]"
                  :class="sourceType==='query' ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-500 hover:text-slate-700'"
                  class="flex-1 py-1.5 text-xs font-semibold transition-all">
            Saved Query
          </button>
          <button type="button" @click="sourceType='sql'; columns=[]; savedQueryId=''"
                  :class="sourceType==='sql' ? 'bg-blue-600 text-white shadow-sm' : 'text-slate-500 hover:text-slate-700'"
                  class="flex-1 py-1.5 text-xs font-semibold transition-all">
            SQL Lab
          </button>
        </div>
      </div>

      {# Saved Query picker #}
      <div x-show="sourceType==='query'" x-transition class="px-4 py-3 border-b border-slate-100">
        <select x-model="savedQueryId" @change="loadColumns()"
                class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2 bg-white
                       focus:ring-2 focus:ring-blue-200 focus:border-blue-400 transition">
          <option value="">— select a saved query —</option>
          {% for q in saved_queries %}
          <option value="{{ q.id }}">{{ q.name }}</option>
          {% endfor %}
        </select>
      </div>

      {# SQL Lab input #}
      <div x-show="sourceType==='sql'" x-transition class="px-4 py-3 border-b border-slate-100 space-y-2">
        <textarea x-model="rawSql" rows="5"
                  class="w-full text-xs font-mono border border-slate-300 rounded-lg px-3 py-2
                         bg-white resize-none focus:ring-2 focus:ring-blue-200 focus:border-blue-400"
                  placeholder="SELECT grade, COUNT(*) as cnt&#10;FROM current_student&#10;WHERE school_year = '2025-2026'&#10;GROUP BY grade"></textarea>
        <button @click="runSql()" :disabled="columnsLoading"
                class="w-full text-xs py-2 bg-slate-700 text-white rounded-lg hover:bg-slate-800
                       transition disabled:opacity-50 font-medium">
          <span x-text="columnsLoading ? 'Running…' : '▶ Run SQL'"></span>
        </button>
      </div>

      {# Column list #}
      <div class="flex-1 overflow-y-auto px-4 py-3">
        <template x-if="columnsLoading">
          <div class="flex items-center gap-2 py-4 justify-center text-slate-400">
            <svg class="animate-spin w-4 h-4" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"/></svg>
            <span class="text-xs">Loading columns…</span>
          </div>
        </template>

        <template x-if="!columnsLoading && columns.length === 0 && rawSqlColumns.length === 0">
          <div class="text-center py-8 text-slate-400">
            <svg class="w-8 h-8 mx-auto mb-2 opacity-50" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/></svg>
            <p class="text-xs">Select a data source<br>to see available columns</p>
          </div>
        </template>

        <template x-if="!columnsLoading && activeColumns.length > 0">
          <div>
            <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-2">
              Columns <span class="text-slate-300" x-text="'(' + activeColumns.length + ')'"></span>
            </p>
            <div class="space-y-1">
              <template x-for="col in activeColumns" :key="col">
                <div class="column-chip flex items-center gap-1.5 text-xs rounded-md border px-2.5 py-1.5
                            bg-white border-slate-200 hover:border-blue-300 hover:bg-blue-50 group"
                     draggable="true"
                     @dragstart="onDragStart($event, col)"
                     @dragend="onDragEnd($event)"
                     :class="isAssigned(col) && 'opacity-40 border-dashed'">
                  <svg class="w-3 h-3 text-slate-300 group-hover:text-blue-400 shrink-0" fill="currentColor" viewBox="0 0 20 20"><circle cx="7" cy="5" r="1.5"/><circle cx="13" cy="5" r="1.5"/><circle cx="7" cy="10" r="1.5"/><circle cx="13" cy="10" r="1.5"/><circle cx="7" cy="15" r="1.5"/><circle cx="13" cy="15" r="1.5"/></svg>
                  <span class="truncate" :title="col" x-text="col"></span>
                </div>
              </template>
            </div>
          </div>
        </template>
      </div>
    </div>

    {# ── CENTER PANEL: Config ────────────────────────────────────────── #}
    <div class="w-[340px] border-r border-slate-200 bg-white overflow-y-auto flex-shrink-0">

      {# Chart Type Picker #}
      <div class="px-4 pt-4 pb-3 border-b border-slate-100">
        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mb-3">Chart Type</p>
        <div class="grid grid-cols-5 gap-1.5">
          {% for key, label, icon, group in chart_types_flat %}
          <button type="button"
                  @click="chartType='{{ key }}'"
                  :class="chartType==='{{ key }}' && 'selected'"
                  class="chart-type-btn flex flex-col items-center text-[10px] border border-slate-200
                         rounded-lg p-1.5 cursor-pointer"
                  title="{{ label }} ({{ group }})">
            <span class="text-lg leading-none mb-0.5">{{ icon }}</span>
            <span class="text-slate-500 truncate w-full text-center leading-tight">{{ label }}</span>
          </button>
          {% endfor %}
        </div>
      </div>

      {# Drop Zones #}
      <div class="px-4 py-4 space-y-3 border-b border-slate-100">
        <p class="text-[10px] font-bold text-slate-400 uppercase tracking-widest">Encoding</p>

        {# X-Axis #}
        <div>
          <label class="text-xs font-semibold text-slate-600 mb-1 block">X-Axis / Category</label>
          <div class="drop-zone rounded-lg border-2 border-dashed border-slate-200 bg-slate-50 px-3 py-2
                      flex items-center"
               @dragover.prevent="$el.classList.add('drag-over')"
               @dragleave="$el.classList.remove('drag-over')"
               @drop.prevent="dropCol($event, 'xCol')">
            <template x-if="!xCol">
              <div class="flex items-center justify-between w-full">
                <span class="text-xs text-slate-400 italic">Drag a column here</span>
                <select @change="xCol=$event.target.value; $event.target.value=''"
                        class="text-xs border-0 bg-transparent text-blue-600 cursor-pointer p-0
                               focus:ring-0 w-auto">
                  <option value="">or pick…</option>
                  <template x-for="col in activeColumns" :key="'x_'+col">
                    <option :value="col" x-text="col"></option>
                  </template>
                </select>
              </div>
            </template>
            <template x-if="xCol">
              <div class="flex items-center gap-2 w-full">
                <span class="inline-flex items-center gap-1 text-xs bg-blue-100 text-blue-800 rounded-md px-2.5 py-1 font-medium">
                  <svg class="w-3 h-3 opacity-60" fill="currentColor" viewBox="0 0 20 20"><path d="M3 3h14v2H3V3zm0 4h10v2H3V7zm0 4h14v2H3v-2zm0 4h10v2H3v-2z"/></svg>
                  <span x-text="xCol" class="truncate max-w-[180px]"></span>
                </span>
                <button @click="xCol=''" class="ml-auto text-slate-400 hover:text-red-500 transition">&times;</button>
              </div>
            </template>
          </div>
        </div>

        {# Y-Axis #}
        <div>
          <label class="text-xs font-semibold text-slate-600 mb-1 block">Y-Axis / Value</label>
          <div class="drop-zone rounded-lg border-2 border-dashed border-slate-200 bg-slate-50 px-3 py-2
                      flex items-center"
               @dragover.prevent="$el.classList.add('drag-over')"
               @dragleave="$el.classList.remove('drag-over')"
               @drop.prevent="dropCol($event, 'yCol')">
            <template x-if="!yCol">
              <div class="flex items-center justify-between w-full">
                <span class="text-xs text-slate-400 italic">Drag a column here</span>
                <select @change="yCol=$event.target.value; $event.target.value=''"
                        class="text-xs border-0 bg-transparent text-blue-600 cursor-pointer p-0
                               focus:ring-0 w-auto">
                  <option value="">or pick…</option>
                  <template x-for="col in activeColumns" :key="'y_'+col">
                    <option :value="col" x-text="col"></option>
                  </template>
                </select>
              </div>
            </template>
            <template x-if="yCol">
              <div class="flex items-center gap-2 w-full">
                <span class="inline-flex items-center gap-1 text-xs bg-emerald-100 text-emerald-800 rounded-md px-2.5 py-1 font-medium">
                  <svg class="w-3 h-3 opacity-60" fill="currentColor" viewBox="0 0 20 20"><path d="M3 17V3h2v14H3zm4-4v4h2v-4H7zm4-6v10h2V7h-2zm4-4v14h2V3h-2z"/></svg>
                  <span x-text="yCol" class="truncate max-w-[180px]"></span>
                </span>
                <button @click="yCol=''" class="ml-auto text-slate-400 hover:text-red-500 transition">&times;</button>
              </div>
            </template>
          </div>
        </div>

        {# Series / Color #}
        <div>
          <label class="text-xs font-semibold text-slate-600 mb-1 block">
            Series / Group-by
            <span class="font-normal text-slate-400 ml-1">optional</span>
          </label>
          <div class="drop-zone rounded-lg border-2 border-dashed border-slate-200 bg-slate-50 px-3 py-2
                      flex items-center"
               @dragover.prevent="$el.classList.add('drag-over')"
               @dragleave="$el.classList.remove('drag-over')"
               @drop.prevent="dropCol($event, 'seriesCol')">
            <template x-if="!seriesCol">
              <div class="flex items-center justify-between w-full">
                <span class="text-xs text-slate-400 italic">Drag a column here</span>
                <select @change="seriesCol=$event.target.value; $event.target.value=''"
                        class="text-xs border-0 bg-transparent text-blue-600 cursor-pointer p-0
                               focus:ring-0 w-auto">
                  <option value="">or pick…</option>
                  <template x-for="col in activeColumns" :key="'s_'+col">
                    <option :value="col" x-text="col"></option>
                  </template>
                </select>
              </div>
            </template>
            <template x-if="seriesCol">
              <div class="flex items-center gap-2 w-full">
                <span class="inline-flex items-center gap-1 text-xs bg-purple-100 text-purple-800 rounded-md px-2.5 py-1 font-medium">
                  <svg class="w-3 h-3 opacity-60" fill="currentColor" viewBox="0 0 20 20"><path d="M4 4a2 2 0 00-2 2v1h16V6a2 2 0 00-2-2H4zM18 9H2v5a2 2 0 002 2h12a2 2 0 002-2V9zM4 13a1 1 0 011-1h1a1 1 0 010 2H5a1 1 0 01-1-1zm5-1a1 1 0 100 2h1a1 1 0 100-2H9z"/></svg>
                  <span x-text="seriesCol" class="truncate max-w-[180px]"></span>
                </span>
                <button @click="seriesCol=''" class="ml-auto text-slate-400 hover:text-red-500 transition">&times;</button>
              </div>
            </template>
          </div>
        </div>
      </div>

      {# Aggregation & Sort #}
      <div class="px-4 py-4 space-y-3 border-b border-slate-100">
        <div>
          <label class="text-xs font-semibold text-slate-600 mb-1 block">Aggregation</label>
          <select x-model="aggFunc"
                  class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-200">
            {% for val, label in agg_choices %}
            <option value="{{ val }}">{{ label }}</option>
            {% endfor %}
          </select>
        </div>

        <div class="flex gap-2">
          <div class="flex-1">
            <label class="text-xs font-semibold text-slate-600 mb-1 block">Sort By</label>
            <select x-model="sortCol"
                    class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-200">
              <option value="">Auto</option>
              <template x-for="col in activeColumns" :key="'sort_'+col">
                <option :value="col" x-text="col"></option>
              </template>
              <option value="_value">Aggregated value</option>
            </select>
          </div>
          <div class="w-24">
            <label class="text-xs font-semibold text-slate-600 mb-1 block">Dir</label>
            <select x-model="sortDir"
                    class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-200">
              <option value="asc">ASC</option>
              <option value="desc">DESC</option>
            </select>
          </div>
        </div>

        <div>
          <label class="text-xs font-semibold text-slate-600 mb-1 block">Row Limit</label>
          <input type="number" x-model.number="limit" min="1" max="5000"
                 class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-200">
        </div>
      </div>

      {# Visual options #}
      <div class="px-4 py-4 space-y-3 border-b border-slate-100" x-data="{ open: false }">
        <button type="button" @click="open=!open"
                class="flex items-center gap-1.5 text-xs font-bold text-slate-500 hover:text-slate-700 uppercase tracking-widest transition">
          <svg class="w-3 h-3 transition-transform" :class="open && 'rotate-90'" fill="currentColor" viewBox="0 0 20 20"><path d="M6 4l8 6-8 6V4z"/></svg>
          Visual Options
        </button>
        <div x-show="open" x-collapse class="space-y-3">
          <div>
            <label class="text-xs font-medium text-slate-600 mb-1 block">Colour Palette</label>
            <select x-model="palette"
                    class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-200">
              <option value="">Default</option>
              {% for p in palettes %}
              <option value="{{ p }}">{{ p|title }}</option>
              {% endfor %}
            </select>
          </div>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" x-model="showLegend" class="rounded border-slate-300 text-blue-600 focus:ring-blue-200">
            <span class="text-xs text-slate-600">Show legend</span>
          </label>
          <label class="flex items-center gap-2 cursor-pointer">
            <input type="checkbox" x-model="showLabels" class="rounded border-slate-300 text-blue-600 focus:ring-blue-200">
            <span class="text-xs text-slate-600">Show data labels</span>
          </label>
        </div>
      </div>

      {# Drill-through #}
      <div class="px-4 py-4 space-y-3" x-data="{ open: false }">
        <button type="button" @click="open=!open"
                class="flex items-center gap-1.5 text-xs font-bold text-slate-500 hover:text-slate-700 uppercase tracking-widest transition">
          <svg class="w-3 h-3 transition-transform" :class="open && 'rotate-90'" fill="currentColor" viewBox="0 0 20 20"><path d="M6 4l8 6-8 6V4z"/></svg>
          Drill-Through
        </button>
        <div x-show="open" x-collapse class="space-y-2">
          <label class="block text-xs font-medium text-slate-600">Columns (comma-separated)</label>
          <input type="text" x-model="drillColumns"
                 class="w-full text-sm border border-slate-300 rounded-lg px-3 py-2 focus:ring-2 focus:ring-blue-200"
                 placeholder="student_id, student_name, grade">
          <p class="text-[10px] text-slate-400">Leave blank to show all columns when drilling through</p>
        </div>
      </div>
    </div>

    {# ── RIGHT PANEL: Preview ────────────────────────────────────────── #}
    <div class="flex-1 bg-slate-50 overflow-auto flex flex-col">
      <div id="chart-preview-area" class="flex-1 p-5">
        {# Preview content injected here #}
        <template x-if="!previewHtml && !previewLoading">
          <div class="w-full h-full flex items-center justify-center">
            <div class="text-center text-slate-400">
              <svg class="w-16 h-16 mx-auto mb-3 opacity-30" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><path stroke-linecap="round" d="M3 3v18h18"/><path stroke-linecap="round" stroke-width="1.5" d="M7 16l4-4 3 3 4-6"/></svg>
              <p class="text-sm font-medium text-slate-500">Chart Preview</p>
              <p class="text-xs mt-1">Select data, map columns, then click <strong>Preview</strong></p>
            </div>
          </div>
        </template>
        <template x-if="previewLoading">
          <div class="w-full h-full flex items-center justify-center">
            <div class="text-center text-slate-400">
              <svg class="animate-spin w-8 h-8 mx-auto mb-2" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"/><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v4a4 4 0 00-4 4H4z"/></svg>
              <p class="text-sm">Building chart…</p>
            </div>
          </div>
        </template>
        <div x-show="previewHtml && !previewLoading" x-html="previewHtml"
             class="w-full h-full min-h-[400px]"></div>
      </div>
    </div>

  </div>
</div>

{# ── Hidden form for API submissions ─────────────────────────────── #}
<form id="chart-form" class="hidden">
  {% csrf_token %}
  <input type="hidden" name="chart_id" x-bind:value="chartId">
  <input type="hidden" name="name" x-bind:value="name">
  <input type="hidden" name="source_type" x-bind:value="sourceType === 'query' ? 'query' : 'sql'">
  <input type="hidden" name="saved_query_id" x-bind:value="savedQueryId">
  <input type="hidden" name="raw_sql" x-bind:value="rawSql">
  <input type="hidden" name="chart_type" x-bind:value="chartType">
  <input type="hidden" name="x_col" x-bind:value="xCol">
  <input type="hidden" name="y_col" x-bind:value="yCol">
  <input type="hidden" name="series_col" x-bind:value="seriesCol">
  <input type="hidden" name="agg_func" x-bind:value="aggFunc">
  <input type="hidden" name="sort_col" x-bind:value="sortCol">
  <input type="hidden" name="sort_dir" x-bind:value="sortDir">
  <input type="hidden" name="limit" x-bind:value="limit">
  <input type="hidden" name="palette" x-bind:value="palette">
  <input type="hidden" name="show_legend" x-bind:value="showLegend ? '1' : ''">
  <input type="hidden" name="show_labels" x-bind:value="showLabels ? '1' : ''">
  <input type="hidden" name="drill_through_columns_str" x-bind:value="drillColumns">
</form>

<script src="{% static 'js/dataviz/chart-renderer.js' %}"></script>
<script>
function chartBuilder() {
  const existing = JSON.parse('{{ existing_chart_json|escapejs }}' || 'null');
  const csrfToken = document.querySelector('[name=csrfmiddlewaretoken]').value;

  return {
    // ── State ────────────────────────────────────────────────
    chartId:       existing ? existing.id : {{ chart_id|default:"null" }},
    name:          existing ? existing.name : '',
    sourceType:    existing ? (existing.source_type === 'sql' ? 'sql' : 'query') : 'query',
    savedQueryId:  existing ? (existing.source_id || '') : '',
    rawSql:        existing ? (existing.source_sql || '') : '',
    chartType:     existing ? (existing.chart_type || 'bar') : 'bar',
    xCol:          existing ? (existing.config.x_col || '') : '',
    yCol:          existing ? (existing.config.y_col || '') : '',
    seriesCol:     existing ? (existing.config.series_col || existing.config.stack_col || '') : '',
    aggFunc:       existing ? (existing.config.agg || existing.config.agg_func || 'count') : 'count',
    sortCol:       existing ? (existing.config.sort_col || '') : '',
    sortDir:       existing ? (existing.config.sort_dir || 'asc') : 'asc',
    limit:         existing ? (existing.config.limit || 500) : 500,
    palette:       existing ? (existing.config.palette || '') : '',
    showLegend:    existing ? !!existing.config.show_legend : true,
    showLabels:    existing ? !!existing.config.data_labels : false,
    drillColumns:  existing ? (existing.drill_through_columns || []).join(', ') : '',

    columns:       [],          // saved query columns
    rawSqlColumns: [],          // SQL lab columns
    columnsLoading: false,
    previewHtml:   '',
    previewLoading: false,
    saving:        false,
    saveMsg:       '',
    saveError:     false,
    draggedCol:    null,

    // ── Computed ─────────────────────────────────────────────
    get activeColumns() {
      return this.sourceType === 'sql' ? this.rawSqlColumns : this.columns;
    },

    isAssigned(col) {
      return col === this.xCol || col === this.yCol || col === this.seriesCol;
    },

    // ── Init ─────────────────────────────────────────────────
    init() {
      if (this.savedQueryId) this.loadColumns();
    },

    // ── Column loading ───────────────────────────────────────
    async loadColumns() {
      if (!this.savedQueryId) { this.columns = []; return; }
      this.columnsLoading = true;
      try {
        const resp = await fetch(`/dataviz/api/query/${this.savedQueryId}/columns/`, {
          headers: { 'X-CSRFToken': csrfToken },
        });
        const data = await resp.json();
        this.columns = data.columns || [];
      } catch (e) {
        console.error('column load error', e);
        this.columns = [];
      }
      this.columnsLoading = false;
    },

    async runSql() {
      if (!this.rawSql.trim()) return;
      this.columnsLoading = true;
      try {
        const resp = await fetch('/dataviz/api/query/sql/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', 'X-CSRFToken': csrfToken },
          body: JSON.stringify({ sql: this.rawSql }),
        });
        const data = await resp.json();
        if (data.error) { alert(data.error); this.rawSqlColumns = []; }
        else { this.rawSqlColumns = data.columns || []; }
      } catch (e) {
        console.error('SQL run error', e);
        this.rawSqlColumns = [];
      }
      this.columnsLoading = false;
    },

    // ── Drag & Drop ──────────────────────────────────────────
    onDragStart(event, col) {
      this.draggedCol = col;
      event.dataTransfer.setData('text/plain', col);
      event.dataTransfer.effectAllowed = 'copy';
      event.target.classList.add('opacity-40');
    },

    onDragEnd(event) {
      this.draggedCol = null;
      event.target.classList.remove('opacity-40');
      document.querySelectorAll('.drop-zone').forEach(el => el.classList.remove('drag-over'));
    },

    dropCol(event, target) {
      event.currentTarget.classList.remove('drag-over');
      const col = event.dataTransfer.getData('text/plain');
      if (col) this[target] = col;
    },

    // ── Preview ──────────────────────────────────────────────
    async preview() {
      this.previewLoading = true;
      this.previewHtml = '';
      try {
        const formData = new FormData(document.getElementById('chart-form'));
        const resp = await fetch('{% url "dataviz:chart_preview" %}', {
          method: 'POST',
          headers: { 'X-CSRFToken': csrfToken },
          body: formData,
        });
        const html = await resp.text();
        this.previewHtml = html;
        // Let the DOM update, then init any ECharts containers
        await this.$nextTick();
        if (window.initAllCharts) window.initAllCharts();
      } catch (e) {
        this.previewHtml = '<div class="text-red-600 text-sm p-4">Preview failed: ' + e.message + '</div>';
      }
      this.previewLoading = false;
    },

    // ── Save ─────────────────────────────────────────────────
    async save() {
      if (!this.name.trim()) { this.saveMsg = 'Enter a chart name'; this.saveError = true; return; }
      this.saving = true;
      this.saveMsg = '';
      try {
        const formData = new FormData(document.getElementById('chart-form'));
        const resp = await fetch('{% url "dataviz:chart_save" %}', {
          method: 'POST',
          headers: { 'X-CSRFToken': csrfToken },
          body: formData,
        });
        if (resp.ok) {
          const html = await resp.text();
          this.saveMsg = 'Saved!';
          this.saveError = false;
          // Try to extract chart id from response (for first-time saves)
          try {
            const data = JSON.parse(html);
            if (data.chart && data.chart.id && !this.chartId) {
              this.chartId = data.chart.id;
              history.replaceState(null, '', `/dataviz/charts/${data.chart.id}/edit/`);
            }
          } catch(_) {
            const match = html.match(/charts\/(\d+)\/edit/);
            if (match && !this.chartId) {
              this.chartId = parseInt(match[1]);
              history.replaceState(null, '', `/dataviz/charts/${match[1]}/edit/`);
            }
          }
        } else {
          const text = await resp.text();
          this.saveMsg = text || 'Save failed';
          this.saveError = true;
        }
      } catch (e) {
        this.saveMsg = 'Error: ' + e.message;
        this.saveError = true;
      }
      this.saving = false;
      setTimeout(() => { this.saveMsg = ''; }, 4000);
    },
  };
}
</script>
{% endblock %}
