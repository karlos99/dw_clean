(function () {
    const utils = window.DVUtils || {};
    const {
        isBlankValue,
        parseJSON,
        toNumber,
        inferColumnType,
        normalizeLabel,
        escapeHtml,
        formatValueForColumn,
        fillSelect,
        readJsonResponse,
    } = utils;

    document.addEventListener('DOMContentLoaded', function () {
        const appData = document.getElementById('dataviz-app-data');
        const appRoot = document.getElementById('dataviz-app');
        if (!appData || !appRoot || typeof Highcharts === 'undefined' || !window.DVChartRenderer || !readJsonResponse) {
            return;
        }

        const loadStudentsUrl = appData.dataset.loadStudentsUrl;
        const renderChartUrl = appData.dataset.renderChartUrl;
        const csrfToken = appData.dataset.csrfToken || '';
        const defaultColumns = parseJSON(appData.dataset.defaultColumns || '[]', []);
        const initialDefinitions = parseJSON(appData.dataset.columnDefinitions || '{}', {});

        const savedQueryEl = document.getElementById('dv-saved-query');
        const searchEl = document.getElementById('dv-search');
        const schoolYearEl = document.getElementById('dv-school-year');
        const gradeEl = document.getElementById('dv-grade');
        const statusEl = document.getElementById('dv-status');
        const loadBtn = document.getElementById('dv-load-data');
        const loadStatus = document.getElementById('dv-load-status');
        const useDefaultBtn = document.getElementById('dv-use-default-columns');

        const chartControlsWrap = document.getElementById('dv-chart-controls');
        const emptyState = document.getElementById('dv-empty-state');
        const chartWrap = document.getElementById('dv-chart-wrap');
        const chartEl = document.getElementById('dv-chart');
        const chartRenderer = window.DVChartRenderer.create(chartEl);
        const chartTypeEl = document.getElementById('dv-chart-type');
        const chartTypeHelpEl = document.getElementById('dv-chart-type-help');
        const xColEl = document.getElementById('dv-x-col');
        const yColEl = document.getElementById('dv-y-col');
        const stackColEl = document.getElementById('dv-stack-col');
        const sizeColEl = document.getElementById('dv-size-col');
        const aggEl = document.getElementById('dv-agg');
        const chartSourceEl = document.getElementById('dv-chart-source');
        const multiXWrapEl = null;
        const multiXTagsEl = null;
        const groupSeriesWrapEl = null;
        const groupSeriesTagsEl = null;
        const seriesHelpEl = null;
        const renderBtn = document.getElementById('dv-render-chart');
        const recommendationsEl = document.getElementById('dv-recommendations');
        const datasetSummaryEl = document.getElementById('dv-dataset-summary');
        const chartCompatEl = document.getElementById('dv-chart-compat');
        const seriesCapabilityEl = null;
        const seriesPinColEl = null;
        const seriesPinChipsEl = null;
        const seriesPinSelectAllEl = null;
        const seriesPinClearAllEl = null;
        const seriesPinStatusEl = null;
        const previewHead = document.getElementById('dv-preview-head');
        const previewBody = document.getElementById('dv-preview-body');
        const filterBarEl = document.getElementById('dv-filter-bar');
        const filterColsEl = document.getElementById('dv-filter-cols');
        const filterSearchEl = document.getElementById('dv-filter-search');
        const filterClearEl = document.getElementById('dv-filter-clear');
        const filterStatusEl = document.getElementById('dv-filter-status');
        const previewPageStatusEl = document.getElementById('dv-preview-page-status');
        const previewPrevBtn = document.getElementById('dv-preview-prev');
        const previewNextBtn = document.getElementById('dv-preview-next');

        const xWrap = document.getElementById('dv-wrap-x');
        const yWrap = document.getElementById('dv-wrap-y');
        const stackWrap = document.getElementById('dv-wrap-stack');
        const sizeWrap = document.getElementById('dv-wrap-size');
        const groupByChipsEl   = document.getElementById('dv-group-by-chips');
        const groupByHintEl    = document.getElementById('dv-group-by-hint');
        const groupByPreviewEl = document.getElementById('dv-group-by-preview');

        const tabDataBtn = document.getElementById('dv-tab-data');
        const tabSummaryBtn = document.getElementById('dv-tab-summary');
        const panelDataEl = document.getElementById('dv-panel-data');
        const panelSummaryEl = document.getElementById('dv-panel-summary');
        const groupByTagsEl = document.getElementById('dv-group-by-tags');
        const groupTableWrapEl = document.getElementById('dv-group-table-wrap');
        const groupMetricModeEl = document.getElementById('dv-group-metric-mode');
        const groupViewModeEl = document.getElementById('dv-group-view-mode');
        const groupApplyViewBtn = document.getElementById('dv-group-apply-view');
        const groupBaseLabelEl = document.getElementById('dv-group-base-label');
        const groupFilterBadgeEl = document.getElementById('dv-group-filter-badge');
        const groupFilterLabelEl = document.getElementById('dv-group-filter-label');
        const groupFilterClearEl = document.getElementById('dv-group-filter-clear');

        const optTitleEl = document.getElementById('dv-opt-title');
        const optPaletteEl = document.getElementById('dv-opt-palette');
        const optBgEl = document.getElementById('dv-opt-bg');
        const optLegendEl = document.getElementById('dv-opt-legend');
        const optLabelsEl = document.getElementById('dv-opt-labels');
        const optSmoothEl = document.getElementById('dv-opt-smooth');
        const optMarkersEl = document.getElementById('dv-opt-markers');
        const optBinsEl = document.getElementById('dv-opt-bins');
        const optCurveEl = document.getElementById('dv-opt-curve');
        const optPointSizeEl = document.getElementById('dv-opt-point-size');
        const optOpacityEl = document.getElementById('dv-opt-opacity');
        const optZoomEl = document.getElementById('dv-opt-zoom');
        const optLineWidthEl = document.getElementById('dv-opt-line-width');
        const optRadiusEl = document.getElementById('dv-opt-radius');
        const optStackModeEl = document.getElementById('dv-opt-stack-mode');
        const optTooltipSharedEl = document.getElementById('dv-opt-tooltip-shared');
        const optAnimateEl = document.getElementById('dv-opt-animate');
        const optInvertedEl = document.getElementById('dv-opt-inverted');
        const optPolarEl = document.getElementById('dv-opt-polar');

        const styleState = {
            title: '',
            palette: 'default',
            background: 'white',
            legendPos: 'bottom',
            dataLabels: false,
            smooth: false,
            showPoints: false,
            bins: 12,
            curve: 'linear',
            pointSize: 6,
            opacity: 0.9,
            zoomPan: true,
            lineWidth: 2,
            borderRadius: 6,
            stackMode: 'normal',
            tooltipShared: true,
            animate: true,
            inverted: false,
            polar: false,
        };

        const state = {
            rows: [],
            columns: [],
            columnDefinitions: { ...initialDefinitions },
            columnTypes: {},
            recommendations: [],
            filterState: { search: '', columns: {} },
            filteredRows: [],
            groupState: { groupKeys: [] },
            groupSeriesCols: [],
            chartXCols: [],
            chartGroupByCols: [],  // extra group-level dimensions (combined with X as composite key)
            groupReport: { metricMode: 'all', viewMode: 'table' },
            previewPage: 1,
        };

        function updateChartTypeHelp() {
            if (!chartTypeHelpEl || !chartTypeEl) {
                return;
            }
            const helps = {
                bar: 'Bar: compare values across categories.',
                grouped_bar: 'Grouped Bar: compare multiple series side-by-side across categories.',
                stacked_bar: 'Stacked Bar: compare totals and composition by category.',
                line: 'Line: track trends across ordered categories.',
                area: 'Area: trend with emphasis on cumulative magnitude.',
                stacked_area: 'Stacked Area: cumulative contribution over categories.',
                pie: 'Pie: show part-to-whole distribution.',
                donut: 'Donut: pie chart with center space for cleaner labels.',
                treemap: 'Treemap: area encodes part-to-whole values by category.',
                funnel: 'Funnel: stage values from largest to smallest.',
                scatter: 'Scatter: examine relationship between two numeric variables.',
                bubble: 'Bubble: scatter plot with a third numeric variable as bubble size.',
                heatmap: 'Heatmap: compare intensity across a category matrix.',
                histogram: 'Histogram: inspect value distribution by bins.',
                box: 'Box plot: compare spread and quartiles by group.',
                radar: 'Radar: compare category metrics in radial form.',
                gauge: 'Gauge: display one aggregate KPI against a range.',
            };
            chartTypeHelpEl.textContent = helps[chartTypeEl.value] || 'Pick a chart type to see guidance.';
        }

        function getSelectedRawMetricCols() {
            return (state.groupSeriesCols || [])
                .filter((c) => String(c).startsWith('__plcnt_'))
                .map((c) => String(c).replace('__plcnt_', ''));
        }

        function getVisibleGroupMetricCols(allNumericCols) {
            const mode = state.groupReport.metricMode || 'all';
            if (mode === 'count') {
                return [];
            }
            if (mode === 'selected') {
                return allNumericCols.filter((c) => (state.groupSeriesCols || []).includes(c));
            }
            return allNumericCols;
        }

        function applyGroupReportViewToChart() {
            const mode = state.groupReport.viewMode || 'table';
            if (mode === 'table') {
                renderGroupSummary();
                return;
            }

            const grouped = getChartSourceDataset();
            if (!grouped.rows.length) {
                renderGroupSummary();
                return;
            }

            const numericCols = (grouped.columns || []).filter((c) => (grouped.columnTypes[c] || 'string') === 'number');
            const metricCols = numericCols.filter((c) => c !== '__group_count' && String(c).startsWith('__plcnt_'));

            let selectedSeries;
            if ((state.groupReport.metricMode || 'all') === 'count') {
                selectedSeries = ['__group_count'];
            } else if ((state.groupReport.metricMode || 'all') === 'selected') {
                selectedSeries = state.groupSeriesCols.filter((c) => metricCols.includes(c));
                if (!selectedSeries.length) {
                    selectedSeries = metricCols.slice(0, 3);
                }
            } else {
                selectedSeries = metricCols.slice(0, 6);
                if (!selectedSeries.length) {
                    selectedSeries = ['__group_count'];
                }
            }

            state.groupSeriesCols = selectedSeries.slice();
            if (chartSourceEl) {
                chartSourceEl.value = 'group';
            }
            state.chartSource = 'group';

            if (chartTypeEl) {
                chartTypeEl.value = mode === 'stacked_bar' ? 'stacked_bar' : 'bar';
            }
            if (aggEl) {
                aggEl.value = 'sum';
            }

            const baseGroup = (state.groupState.groupKeys || [])[0] || '';
            if (baseGroup) {
                xColEl.value = baseGroup;
                state.chartXCols = [baseGroup];
            }
            yColEl.value = selectedSeries[0] || '__group_count';
            stackColEl.value = '';

            syncControlsForChartType();
            autoRenderChart();
        }

        let chartRequestNonce = 0;

        const chartCatalog = [
            { value: 'bar', label: 'Bar', group: 'Bar & Line', minAny: 1 },
            { value: 'grouped_bar', label: 'Grouped Bar', group: 'Bar & Line', minAny: 1 },
            { value: 'stacked_bar', label: 'Stacked Bar', group: 'Bar & Line', minAny: 1 },
            { value: 'line', label: 'Line', group: 'Bar & Line', minAny: 1 },
            { value: 'area', label: 'Area', group: 'Bar & Line', minAny: 1 },
            { value: 'stacked_area', label: 'Stacked Area', group: 'Bar & Line', minAny: 1 },
            { value: 'scatter', label: 'Scatter', group: 'Distribution', minNumeric: 2 },
            { value: 'bubble', label: 'Bubble', group: 'Distribution', minNumeric: 3 },
            { value: 'histogram', label: 'Histogram', group: 'Distribution', minAny: 1 },
            { value: 'box', label: 'Box Plot', group: 'Distribution', minNumeric: 1 },
            { value: 'heatmap', label: 'Heatmap', group: 'Distribution', minAny: 2 },
            { value: 'pie', label: 'Pie', group: 'Part-of-Whole', minAny: 1 },
            { value: 'donut', label: 'Donut', group: 'Part-of-Whole', minAny: 1 },
            { value: 'treemap', label: 'Treemap', group: 'Part-of-Whole', minAny: 1 },
            { value: 'funnel', label: 'Funnel', group: 'Part-of-Whole', minAny: 1 },
            { value: 'radar', label: 'Radar', group: 'Advanced', minAny: 1 },
            { value: 'gauge', label: 'Gauge', group: 'Advanced', minNumeric: 1 },
        ];
        const aggOptions = [
            { value: 'count', label: 'Count' },
            { value: 'sum', label: 'Sum' },
            { value: 'avg', label: 'Average' },
            { value: 'min', label: 'Minimum' },
            { value: 'max', label: 'Maximum' },
            { value: 'median', label: 'Median' },
        ];
        const supportedCharts = chartCatalog.map((c) => c.value);

        function getColumnCounts() {
            const chartDataset = getChartSourceDataset();
            const pools = getColumnPools(chartDataset.columnTypes, chartDataset.columns);
            return { numeric: pools.number.length, category: pools.nonNumber.length, any: chartDataset.columns.length };
        }

        function updateChartTypeOptions() {
            if (!chartTypeEl) {
                return;
            }

            const counts = getColumnCounts();
            const selectedValue = chartTypeEl.value;
            const grouped = {};
            const noData = counts.any === 0;

            chartCatalog.forEach((item) => {
                if (!grouped[item.group]) {
                    grouped[item.group] = [];
                }
                const okCategory = noData || !item.minCategory || counts.category >= item.minCategory;
                const okNumeric = noData || !item.minNumeric || counts.numeric >= item.minNumeric;
                const okAny = noData || !item.minAny || counts.any >= item.minAny;
                grouped[item.group].push({ ...item, available: !!(okCategory && okNumeric && okAny) });
            });

            chartTypeEl.innerHTML = '';
            Object.keys(grouped).forEach((groupName) => {
                const groupEl = document.createElement('optgroup');
                groupEl.label = groupName;
                grouped[groupName].forEach((item) => {
                    const opt = document.createElement('option');
                    opt.value = item.value;
                    opt.textContent = item.available ? item.label : `${item.label} (requires matching data)`;
                    opt.disabled = !item.available;
                    groupEl.appendChild(opt);
                });
                chartTypeEl.appendChild(groupEl);
            });

            const available = Array.from(chartTypeEl.querySelectorAll('option:not(:disabled)')).map((o) => o.value);
            if (available.includes(selectedValue)) {
                chartTypeEl.value = selectedValue;
            } else if (available.length) {
                chartTypeEl.value = available[0];
            }
        }

        function getSelectedColumns() {
            const seen = new Set();
            const selected = [];

            document.querySelectorAll('.dv-col:checked, input[data-column]:checked').forEach((input) => {
                const key = input.dataset.column || input.value;
                if (key && !seen.has(key)) {
                    seen.add(key);
                    selected.push(key);
                }
            });

            return selected;
        }

        function applyDefaultColumns() {
            const selected = new Set(defaultColumns || []);
            document.querySelectorAll('.dv-col, input[data-column]').forEach((input) => {
                const key = input.dataset.column || input.value;
                input.checked = selected.has(key);
            });
        }

        function initTreeToggles() {
            document.querySelectorAll('[data-toggle-category]').forEach((button) => {
                button.addEventListener('click', function () {
                    const targetKey = button.dataset.toggleCategory;
                    const target = document.querySelector(`[data-category="${targetKey}"]`);
                    if (!target) {
                        return;
                    }
                    target.classList.toggle('hidden');
                });
            });
        }

        function getActiveRows() {
            return state.filteredRows && state.filteredRows.length >= 0 ? state.filteredRows : state.rows;
        }

        function getOrderedColumnValues(col) {
            const distinct = new Set();
            for (const row of state.rows) {
                const raw = row[col];
                if (!isBlankValue(raw)) {
                    distinct.add(String(raw));
                }
            }
            const values = Array.from(distinct);
            const numeric = values.every((v) => !Number.isNaN(Number(v)));
            if (numeric) {
                values.sort((a, b) => Number(a) - Number(b));
            } else {
                values.sort((a, b) => a.localeCompare(b, undefined, { numeric: true, sensitivity: 'base' }));
            }
            return values;
        }


        function updateBuildAssistant() {
            if (!datasetSummaryEl || !chartCompatEl || !chartTypeEl) {
                return;
            }

            const rows = getActiveRows();
            const numericCount = state.columns.filter((c) => (state.columnTypes[c] || 'string') === 'number').length;
            const categoryCount = state.columns.length - numericCount;
            datasetSummaryEl.textContent = `${rows.length.toLocaleString()} rows ready • ${state.columns.length} columns (${numericCount} numeric, ${categoryCount} categorical)`;

            const availableLabels = Array.from(chartTypeEl.querySelectorAll('option:not(:disabled)')).map((opt) => opt.textContent.replace(' (requires matching data)', ''));
            const preview = availableLabels.slice(0, 8).join(', ');
            chartCompatEl.textContent = availableLabels.length
                ? `Compatible charts: ${preview}${availableLabels.length > 8 ? '…' : ''}`
                : 'No compatible chart types with current dataset.';

        }

        function buildRecommendations() {
            const numberCols = state.columns.filter((column) => (state.columnTypes[column] || 'string') === 'number');
            const stringCols = state.columns.filter((column) => (state.columnTypes[column] || 'string') !== 'number');

            const recs = [];
            if (stringCols.length) {
                recs.push(`Use ${normalizeLabel(state.columnDefinitions[stringCols[0]] || stringCols[0])} as category`);
            }
            if (numberCols.length) {
                recs.push(`Use ${normalizeLabel(state.columnDefinitions[numberCols[0]] || numberCols[0])} as value`);
            }
            if (!recs.length) {
                recs.push('Load data and select columns to see recommendations');
            }

            state.recommendations = recs;
            recommendationsEl.textContent = recs.join(' • ');
            updateBuildAssistant();
        }

        function renderPreview() {
            const rows = getActiveRows();
            const columns = state.columns;

            if (!columns.length) {
                previewHead.innerHTML = '';
                previewBody.innerHTML = '<tr><td class="px-3 py-4 text-slate-500" colspan="1">No columns selected.</td></tr>';
                if (previewPageStatusEl) {
                    previewPageStatusEl.textContent = 'Rows 0-0 of 0';
                }
                if (previewPrevBtn) {
                    previewPrevBtn.disabled = true;
                }
                if (previewNextBtn) {
                    previewNextBtn.disabled = true;
                }
                return;
            }

            previewHead.innerHTML = `<tr>${columns.map((column) => {
                const label = normalizeLabel(state.columnDefinitions[column] || column);
                return `<th class="text-left px-3 py-2 font-semibold text-slate-700 whitespace-nowrap">${label}</th>`;
            }).join('')}</tr>`;

            if (!rows.length) {
                previewBody.innerHTML = `<tr><td class="px-3 py-4 text-slate-400 italic" colspan="${columns.length}">No rows match current filters.</td></tr>`;
                if (previewPageStatusEl) {
                    previewPageStatusEl.textContent = 'Rows 0-0 of 0';
                }
                if (previewPrevBtn) {
                    previewPrevBtn.disabled = true;
                }
                if (previewNextBtn) {
                    previewNextBtn.disabled = true;
                }
                return;
            }

            const totalRows = rows.length;
            const pageSize = state.previewPageSize || 100;
            const totalPages = Math.max(1, Math.ceil(totalRows / pageSize));
            if (state.previewPage > totalPages) {
                state.previewPage = totalPages;
            }
            if (state.previewPage < 1) {
                state.previewPage = 1;
            }

            const start = (state.previewPage - 1) * pageSize;
            const end = Math.min(start + pageSize, totalRows);
            const sample = rows.slice(start, end);

            previewBody.innerHTML = sample.map((row) => {
                return `<tr class="hover:bg-slate-50">${columns.map((column) => {
                    const raw = row[column];
                    const text = isBlankValue(raw) ? '—' : formatValueForColumn(column, raw);
                    return `<td class="px-3 py-2 text-slate-700 whitespace-nowrap">${escapeHtml(text)}</td>`;
                }).join('')}</tr>`;
            }).join('');

            if (previewPageStatusEl) {
                previewPageStatusEl.textContent = `Rows ${start + 1}-${end} of ${totalRows.toLocaleString()}`;
            }
            if (previewPrevBtn) {
                previewPrevBtn.disabled = state.previewPage <= 1;
            }
            if (previewNextBtn) {
                previewNextBtn.disabled = state.previewPage >= totalPages;
            }
        }

        function updateFilterStatus() {
            const total = state.rows.length;
            const filtered = getActiveRows().length;
            if (!total) {
                filterStatusEl.textContent = '';
                return;
            }
            if (filtered === total) {
                filterStatusEl.textContent = `${total.toLocaleString()} rows`;
                return;
            }
            filterStatusEl.textContent = `${filtered.toLocaleString()} of ${total.toLocaleString()} rows (filtered)`;
        }

        function applyFilters() {
            const baseRows = state.rows;
            const activeSearch = (state.filterState.search || '').toLowerCase().trim();
            const activeColumnFilters = state.filterState.columns || {};

            state.filteredRows = baseRows.filter((row) => {
                if (activeSearch) {
                    const searchHit = state.columns.some((column) => {
                        const raw = row[column];
                        if (isBlankValue(raw)) {
                            return false;
                        }
                        return String(raw).toLowerCase().includes(activeSearch);
                    });
                    if (!searchHit) {
                        return false;
                    }
                }

                for (const [col, filterVal] of Object.entries(activeColumnFilters)) {
                    if (filterVal == null || filterVal === '' || (typeof filterVal === 'object' && !Object.keys(filterVal).length)) {
                        continue;
                    }

                    const colType = state.columnTypes[col] || 'string';
                    if (Array.isArray(filterVal)) {
                        const rowVal = isBlankValue(row[col]) ? '(Blank)' : String(row[col]);
                        if (!filterVal.includes(rowVal)) {
                            return false;
                        }
                    } else if (colType === 'number' && typeof filterVal === 'object') {
                        const num = toNumber(row[col]);
                        if (num === null) {
                            return false;
                        }
                        const min = filterVal.min;
                        const max = filterVal.max;
                        if (min !== '' && min != null && num < Number(min)) {
                            return false;
                        }
                        if (max !== '' && max != null && num > Number(max)) {
                            return false;
                        }
                    } else {
                        const rowVal = isBlankValue(row[col]) ? '(Blank)' : String(row[col]);
                        if (rowVal !== filterVal) {
                            return false;
                        }
                    }
                }
                return true;
            });

            updateFilterStatus();
            state.previewPage = 1;
            renderPreview();
            updateBuildAssistant();
            autoRenderChart();

            if (panelSummaryEl && !panelSummaryEl.classList.contains('hidden')) {
                renderGroupSummary();
            }
        }

        function buildFilterBar() {
            if (!filterColsEl || !filterBarEl) {
                return;
            }

            filterColsEl.innerHTML = '';
            const rows = state.rows;

            const closeFilterPanels = () => {
                filterColsEl.querySelectorAll('[data-dv-filter-panel]').forEach((panel) => {
                    panel.classList.add('hidden');
                });
            };

            if (!filterColsEl.dataset.outsideBound) {
                filterColsEl.dataset.outsideBound = 'true';
                document.addEventListener('click', (event) => {
                    if (!filterColsEl.contains(event.target)) {
                        closeFilterPanels();
                    }
                });
            }

            state.columns.forEach((col) => {
                const colType = state.columnTypes[col] || 'string';
                const label = normalizeLabel(state.columnDefinitions[col] || col);

                if (colType === 'number') {
                    const nums = rows.map((r) => toNumber(r[col])).filter((n) => n !== null);
                    if (!nums.length) {
                        return;
                    }
                    const minVal = Math.min(...nums);
                    const maxVal = Math.max(...nums);

                    const existing = state.filterState.columns[col];
                    const hasActive = !!(existing && typeof existing === 'object' && !Array.isArray(existing) && (existing.min !== '' || existing.max !== ''));

                    const wrap = document.createElement('div');
                    wrap.className = 'relative';
                    wrap.innerHTML = `
                        <button type="button" data-dv-filter-toggle class="text-[11px] font-semibold px-2 py-1 rounded border ${hasActive ? 'bg-blue-50 text-blue-700 border-blue-300' : 'bg-white text-slate-600 border-slate-300 hover:bg-slate-50'}">${escapeHtml(label)}</button>
                        <div data-dv-filter-panel class="hidden absolute z-20 mt-1 w-64 bg-white border border-slate-200 rounded-md shadow-lg p-2 space-y-2">
                            <div class="text-[10px] font-bold text-slate-500 uppercase tracking-wider">Range</div>
                            <div class="flex items-center gap-2">
                                <input type="number" step="any" data-bound="min" placeholder="Min" class="w-full px-2 py-1 text-xs border border-slate-300 rounded" value="${existing && existing.min != null ? escapeHtml(existing.min) : ''}">
                                <span class="text-xs text-slate-400">to</span>
                                <input type="number" step="any" data-bound="max" placeholder="Max" class="w-full px-2 py-1 text-xs border border-slate-300 rounded" value="${existing && existing.max != null ? escapeHtml(existing.max) : ''}">
                            </div>
                            <div class="text-[10px] text-slate-400">Data range: ${minVal.toLocaleString()} – ${maxVal.toLocaleString()}</div>
                            <div class="flex items-center justify-between border-t border-slate-200 pt-2">
                                <button type="button" data-dv-filter-reset class="text-xs text-slate-500 hover:text-slate-700">Reset</button>
                                <button type="button" data-dv-filter-apply class="text-xs font-semibold text-blue-600 hover:text-blue-800">Apply</button>
                            </div>
                        </div>
                    `;

                    const toggleBtn = wrap.querySelector('[data-dv-filter-toggle]');
                    const panel = wrap.querySelector('[data-dv-filter-panel]');
                    const minInput = wrap.querySelector('input[data-bound="min"]');
                    const maxInput = wrap.querySelector('input[data-bound="max"]');
                    const applyBtn = wrap.querySelector('[data-dv-filter-apply]');
                    const resetBtn = wrap.querySelector('[data-dv-filter-reset]');

                    minInput.min = minVal;
                    minInput.max = maxVal;
                    maxInput.min = minVal;
                    maxInput.max = maxVal;

                    toggleBtn.addEventListener('click', (event) => {
                        event.stopPropagation();
                        const willOpen = panel.classList.contains('hidden');
                        closeFilterPanels();
                        panel.classList.toggle('hidden', !willOpen);
                    });

                    applyBtn.addEventListener('click', () => {
                        const min = minInput.value;
                        const max = maxInput.value;
                        if (min === '' && max === '') {
                            delete state.filterState.columns[col];
                        } else {
                            state.filterState.columns[col] = { min, max };
                        }
                        panel.classList.add('hidden');
                        applyFilters();
                    });

                    resetBtn.addEventListener('click', () => {
                        minInput.value = '';
                        maxInput.value = '';
                        delete state.filterState.columns[col];
                        panel.classList.add('hidden');
                        applyFilters();
                    });

                    filterColsEl.appendChild(wrap);
                    return;
                }

                const distinct = new Set();
                for (const row of rows) {
                    distinct.add(isBlankValue(row[col]) ? '(Blank)' : String(row[col]));
                    if (distinct.size > 50) {
                        break;
                    }
                }

                if (distinct.size < 2 || distinct.size > 50) {
                    return;
                }

                const existingValsRaw = state.filterState.columns[col];
                const existingVals = Array.isArray(existingValsRaw)
                    ? existingValsRaw.slice()
                    : (typeof existingValsRaw === 'string' ? [existingValsRaw] : []);

                const sortedOptions = Array.from(distinct).sort((a, b) => String(a).localeCompare(String(b)));
                const hasActive = existingVals.length > 0;

                const wrap = document.createElement('div');
                wrap.className = 'relative';
                wrap.innerHTML = `
                    <button type="button" data-dv-filter-toggle class="text-[11px] font-semibold px-2 py-1 rounded border ${hasActive ? 'bg-blue-50 text-blue-700 border-blue-300' : 'bg-white text-slate-600 border-slate-300 hover:bg-slate-50'}">${escapeHtml(label)}${hasActive ? ` (${existingVals.length})` : ''}</button>
                    <div data-dv-filter-panel class="hidden absolute z-20 mt-1 w-64 bg-white border border-slate-200 rounded-md shadow-lg">
                        <div class="flex items-center justify-between px-2 py-1 text-[11px] text-slate-500 border-b border-slate-200">
                            <button type="button" data-dv-filter-selectall class="hover:text-slate-700">Select all</button>
                            <button type="button" data-dv-filter-clearall class="hover:text-slate-700">Clear</button>
                        </div>
                        <div class="max-h-56 overflow-auto p-2 space-y-1" data-dv-options></div>
                        <div class="flex items-center justify-between border-t border-slate-200 px-2 py-1 text-xs">
                            <button type="button" data-dv-filter-reset class="text-slate-500 hover:text-slate-700">Reset</button>
                            <button type="button" data-dv-filter-apply class="text-blue-600 hover:text-blue-700 font-semibold">Apply</button>
                        </div>
                    </div>
                `;

                const toggleBtn = wrap.querySelector('[data-dv-filter-toggle]');
                const panel = wrap.querySelector('[data-dv-filter-panel]');
                const optionsWrap = wrap.querySelector('[data-dv-options]');
                const applyBtn = wrap.querySelector('[data-dv-filter-apply]');
                const resetBtn = wrap.querySelector('[data-dv-filter-reset]');
                const selAllBtn = wrap.querySelector('[data-dv-filter-selectall]');
                const clearAllBtn = wrap.querySelector('[data-dv-filter-clearall]');

                optionsWrap.innerHTML = sortedOptions.map((value) => {
                    const display = value === '(Blank)'
                        ? '(Blank)'
                        : formatValueForColumn(col, value);
                    const checked = existingVals.includes(value) ? 'checked' : '';
                    return `
                        <label class="flex items-center gap-2 text-xs text-slate-700 p-1 rounded hover:bg-slate-50">
                            <input type="checkbox" data-dv-filter-option value="${escapeHtml(value)}" ${checked} class="rounded border-slate-300 text-blue-600 focus:ring-blue-600">
                            <span>${escapeHtml(display)}</span>
                        </label>
                    `;
                }).join('');

                toggleBtn.addEventListener('click', (event) => {
                    event.stopPropagation();
                    const willOpen = panel.classList.contains('hidden');
                    closeFilterPanels();
                    panel.classList.toggle('hidden', !willOpen);
                });

                selAllBtn.addEventListener('click', () => {
                    optionsWrap.querySelectorAll('input[data-dv-filter-option]').forEach((input) => {
                        input.checked = true;
                    });
                });

                clearAllBtn.addEventListener('click', () => {
                    optionsWrap.querySelectorAll('input[data-dv-filter-option]').forEach((input) => {
                        input.checked = false;
                    });
                });

                applyBtn.addEventListener('click', () => {
                    const values = Array.from(optionsWrap.querySelectorAll('input[data-dv-filter-option]:checked')).map((input) => input.value);
                    if (values.length) {
                        state.filterState.columns[col] = values;
                    } else {
                        delete state.filterState.columns[col];
                    }
                    panel.classList.add('hidden');
                    applyFilters();
                });

                resetBtn.addEventListener('click', () => {
                    delete state.filterState.columns[col];
                    optionsWrap.querySelectorAll('input[data-dv-filter-option]').forEach((input) => {
                        input.checked = false;
                    });
                    panel.classList.add('hidden');
                    applyFilters();
                });

                filterColsEl.appendChild(wrap);
            });

            filterSearchEl.value = state.filterState.search || '';
            filterSearchEl.oninput = () => {
                state.filterState.search = filterSearchEl.value || '';
                applyFilters();
            };

            filterClearEl.onclick = () => {
                state.filterState = { search: '', columns: {} };
                filterSearchEl.value = '';
                closeFilterPanels();
                if (groupFilterBadgeEl) {
                    groupFilterBadgeEl.classList.add('hidden');
                    groupFilterBadgeEl.classList.remove('flex');
                }
                buildFilterBar();
                applyFilters();
            };

            filterBarEl.classList.remove('hidden');
            updateFilterStatus();
        }

        function setControlVisible(wrapperEl, visible) {
            if (!wrapperEl) {
                return;
            }
            wrapperEl.style.display = visible ? '' : 'none';
        }

        function getChartSourceDataset() {
            return {
                rows: getActiveRows(),
                columns: state.columns,
                columnTypes: state.columnTypes,
                columnDefinitions: state.columnDefinitions,
                usingGroup: false,
            };
        }

        function getColumnPools(chartColumnTypes, chartColumns) {
            const number = [];
            const nonNumber = [];

            chartColumns.forEach((column) => {
                if ((chartColumnTypes[column] || 'string') === 'number') {
                    number.push(column);
                } else {
                    nonNumber.push(column);
                }
            });

            return { number, nonNumber };
        }

        function syncControlsForChartType() {
            const chartType = chartTypeEl.value || 'bar';
            const chartDataset = getChartSourceDataset();
            const pools = getColumnPools(chartDataset.columnTypes, chartDataset.columns);
            const allCols = [...pools.nonNumber, ...pools.number];

            let xPool = allCols;
            let yPool = allCols;   // all columns allowed as Y; string cols auto-force count agg
            let stackPool = allCols;
            let sizePool = pools.number;
            let showX = true;
            let showY = true;
            let showStack = true;
            let showSize = false;

            if (chartType === 'scatter') {
                xPool = pools.number;
                yPool = pools.number;
                stackPool = pools.nonNumber;
                showSize = false;
            } else if (chartType === 'bubble') {
                xPool = pools.number;
                yPool = pools.number;
                stackPool = pools.nonNumber;
                sizePool = pools.number;
                showSize = true;
            } else if (chartType === 'heatmap') {
                xPool = pools.nonNumber.length ? pools.nonNumber : allCols;
                yPool = pools.nonNumber.length ? pools.nonNumber : allCols;
                stackPool = [];
                showStack = false;
            } else if (chartType === 'pie' || chartType === 'donut' || chartType === 'funnel' || chartType === 'treemap' || chartType === 'radar') {
                xPool = allCols;
                yPool = allCols;   // string Y → count automatically
                stackPool = [];
                showStack = false;
            } else if (chartType === 'histogram') {
                xPool = allCols;
                yPool = [];
                showY = false;
                stackPool = allCols;
            } else if (chartType === 'box') {
                xPool = allCols;
                yPool = pools.number;
                stackPool = [];
                showStack = false;
            } else if (chartType === 'gauge') {
                xPool = [];
                yPool = pools.number;
                stackPool = [];
                showX = false;
                showStack = false;
            }

            const xCurrent = xColEl.value;
            const yCurrent = yColEl.value;
            const sCurrent = stackColEl.value;
            const zCurrent = sizeColEl.value;

            fillSelect(xColEl, xPool.map((c) => ({ value: c, label: chartDataset.columnDefinitions[c] || c })), 'Select...');
            fillSelect(yColEl, yPool.map((c) => ({ value: c, label: chartDataset.columnDefinitions[c] || c })), 'Select...');
            fillSelect(stackColEl, stackPool.map((c) => ({ value: c, label: chartDataset.columnDefinitions[c] || c })), 'None');
            fillSelect(sizeColEl, sizePool.map((c) => ({ value: c, label: chartDataset.columnDefinitions[c] || c })), 'Auto');

            if (xPool.includes(xCurrent)) {
                xColEl.value = xCurrent;
            }
            if (yPool.includes(yCurrent)) {
                yColEl.value = yCurrent;
            }
            if (stackPool.includes(sCurrent)) {
                stackColEl.value = sCurrent;
            }
            if (sizePool.includes(zCurrent)) {
                sizeColEl.value = zCurrent;
            }

            if (!xColEl.value && xPool.length) {
                xColEl.value = xPool[0];
            }
            if (!yColEl.value && yPool.length) {
                yColEl.value = yPool[0];
            }

            const aggByChart = {
                bar: ['count', 'sum', 'avg', 'min', 'max', 'median'],
                grouped_bar: ['count', 'sum', 'avg', 'min', 'max', 'median'],
                stacked_bar: ['count', 'sum', 'avg', 'min', 'max', 'median'],
                line: ['count', 'sum', 'avg', 'min', 'max', 'median'],
                area: ['count', 'sum', 'avg', 'min', 'max', 'median'],
                stacked_area: ['count', 'sum', 'avg', 'min', 'max', 'median'],
                pie: ['count', 'sum', 'avg', 'min', 'max', 'median'],
                donut: ['count', 'sum', 'avg', 'min', 'max', 'median'],
                treemap: ['count', 'sum', 'avg', 'min', 'max', 'median'],
                funnel: ['count', 'sum', 'avg', 'min', 'max', 'median'],
                radar: ['count', 'sum', 'avg', 'min', 'max', 'median'],
                heatmap: ['count'],
                gauge: ['count', 'sum', 'avg', 'min', 'max', 'median'],
                histogram: ['count'],
                box: ['count'],
                scatter: ['count'],
                bubble: ['count'],
            };
            const numericAggs = new Set(['sum', 'avg', 'min', 'max', 'median']);
            const selectedAgg = aggEl.value || 'count';
            const chartAggs = aggByChart[chartType] || ['count'];

            // Only allow numeric aggs when the currently-selected Y column is actually numeric.
            // If no Y is selected (or Y is a string col), restrict to count.
            const ySelected = yColEl.value || '';
            const yIsNumeric = !!ySelected && (chartDataset.columnTypes[ySelected] || 'string') === 'number';
            const allowedAggs = chartAggs.filter((agg) => agg === 'count' || yIsNumeric);
            fillSelect(
                aggEl,
                aggOptions
                    .filter((opt) => allowedAggs.includes(opt.value))
                    .map((opt) => ({ value: opt.value, label: opt.label })),
                'Count',
            );
            if (allowedAggs.includes(selectedAgg)) {
                aggEl.value = selectedAgg;
            } else if (allowedAggs.includes('count')) {
                aggEl.value = 'count';
            } else if (allowedAggs.length) {
                aggEl.value = allowedAggs[0];
            }

            if (numericAggs.has(aggEl.value) && !yIsNumeric) {
                aggEl.value = 'count';
            }

            setControlVisible(xWrap, showX);
            setControlVisible(yWrap, showY);
            setControlVisible(stackWrap, showStack);
            setControlVisible(sizeWrap, showSize);

            xColEl.disabled = !showX;
            yColEl.disabled = !showY;
            stackColEl.disabled = !showStack;
            sizeColEl.disabled = !showSize;
            aggEl.disabled = false;

            const supports = {
                bins: chartType === 'histogram',
                curve: ['line', 'area', 'stacked_area', 'radar'].includes(chartType),
                markers: ['line', 'area', 'stacked_area', 'scatter', 'bubble', 'radar'].includes(chartType),
                pointSize: ['line', 'area', 'stacked_area', 'scatter', 'bubble', 'radar'].includes(chartType),
                lineWidth: ['line', 'area', 'stacked_area', 'scatter', 'bubble', 'radar'].includes(chartType),
                radius: ['bar', 'grouped_bar', 'stacked_bar', 'pie', 'donut', 'funnel', 'treemap'].includes(chartType),
                stackMode: ['stacked_bar', 'stacked_area'].includes(chartType),
                tooltipShared: !['pie', 'donut', 'treemap', 'funnel', 'gauge'].includes(chartType),
                polar: ['line', 'area', 'stacked_area', 'bar', 'grouped_bar', 'stacked_bar', 'scatter', 'radar'].includes(chartType),
                inverted: !['pie', 'donut', 'treemap', 'funnel', 'gauge', 'radar'].includes(chartType),
                zoomPan: !['gauge', 'pie', 'donut', 'funnel'].includes(chartType),
            };

            function setStyleEnabled(controlEl, enabled, fallbackValue) {
                if (!controlEl) {
                    return;
                }
                controlEl.disabled = !enabled;
                const wrap = controlEl.closest('div, label');
                if (wrap) {
                    wrap.classList.toggle('opacity-50', !enabled);
                }
                if (!enabled && fallbackValue !== undefined) {
                    if (controlEl.type === 'checkbox') {
                        controlEl.checked = !!fallbackValue;
                    } else {
                        controlEl.value = String(fallbackValue);
                    }
                }
            }

            setStyleEnabled(optBinsEl, supports.bins, 12);
            if (!supports.bins) {
                styleState.bins = 12;
            }

            setStyleEnabled(optCurveEl, supports.curve, 'linear');
            if (!supports.curve) {
                styleState.curve = 'linear';
            }

            setStyleEnabled(optMarkersEl, supports.markers, false);
            if (!supports.markers) {
                styleState.showPoints = false;
            }

            setStyleEnabled(optPointSizeEl, supports.pointSize, 6);
            if (!supports.pointSize) {
                styleState.pointSize = 6;
            }

            setStyleEnabled(optLineWidthEl, supports.lineWidth, 2);
            if (!supports.lineWidth) {
                styleState.lineWidth = 2;
            }

            setStyleEnabled(optRadiusEl, supports.radius, 6);
            if (!supports.radius) {
                styleState.borderRadius = 6;
            }

            setStyleEnabled(optStackModeEl, supports.stackMode, 'normal');
            if (!supports.stackMode) {
                styleState.stackMode = 'normal';
            }

            setStyleEnabled(optTooltipSharedEl, supports.tooltipShared, true);
            if (!supports.tooltipShared) {
                styleState.tooltipShared = true;
            }

            setStyleEnabled(optPolarEl, supports.polar, false);
            if (!supports.polar) {
                styleState.polar = false;
            }

            setStyleEnabled(optInvertedEl, supports.inverted, false);
            if (!supports.inverted) {
                styleState.inverted = false;
            }

            setStyleEnabled(optZoomEl, supports.zoomPan, true);
            if (!supports.zoomPan) {
                styleState.zoomPan = true;
            }
        }


        function switchTab(name) {
            const isData = name === 'data';

            if (panelDataEl) {
                panelDataEl.classList.toggle('hidden', !isData);
            }
            if (panelSummaryEl) {
                panelSummaryEl.classList.toggle('hidden', isData);
            }

            if (tabDataBtn && tabSummaryBtn) {
                const activate = (el) => {
                    el.classList.add('border-slate-900', 'text-slate-900');
                    el.classList.remove('border-transparent', 'text-slate-400');
                };
                const deactivate = (el) => {
                    el.classList.remove('border-slate-900', 'text-slate-900');
                    el.classList.add('border-transparent', 'text-slate-400');
                };

                if (isData) {
                    activate(tabDataBtn);
                    deactivate(tabSummaryBtn);
                } else {
                    activate(tabSummaryBtn);
                    deactivate(tabDataBtn);
                    renderGroupSummary();
                }
            }
        }

        function computeGroupSummary(rows, groupKeys) {
            if (!groupKeys.length) {
                return [];
            }

            const numericCols = state.columns
                .filter((c) => (state.columnTypes[c] || 'string') === 'number')
                .slice(0, 6);

            const groups = new Map();

            rows.forEach((row) => {
                const keyParts = groupKeys.map((k) => (isBlankValue(row[k]) ? '(Blank)' : String(row[k])));
                const joinedKey = keyParts.join('‖');

                if (!groups.has(joinedKey)) {
                    const entry = { keyParts, count: 0 };
                    numericCols.forEach((c) => {
                        entry[`sum_${c}`] = 0;
                        entry[`cnt_${c}`] = 0;
                    });
                    groups.set(joinedKey, entry);
                }

                const entry = groups.get(joinedKey);
                entry.count += 1;

                numericCols.forEach((c) => {
                    const n = toNumber(row[c]);
                    if (n !== null) {
                        entry[`sum_${c}`] += n;
                        entry[`cnt_${c}`] += 1;
                    }
                });
            });

            return Array.from(groups.values()).sort((a, b) => b.count - a.count).map((entry) => ({
                keyParts: entry.keyParts,
                count: entry.count,
                numericCols,
                entry,
            }));
        }

        function setGroupFilter(keyParts, groupKeys) {
            groupKeys.forEach((k, i) => {
                state.filterState.columns[k] = keyParts[i];
            });

            buildFilterBar();

            if (groupFilterBadgeEl && groupFilterLabelEl) {
                const label = groupKeys.map((k, i) => `${normalizeLabel(state.columnDefinitions[k] || k)} = ${keyParts[i]}`).join(' · ');
                groupFilterLabelEl.textContent = label;
                groupFilterBadgeEl.classList.remove('hidden');
                groupFilterBadgeEl.classList.add('flex');
            }

            applyFilters();
            switchTab('data');
        }

        function renderGroupSummary() {
            if (!groupTableWrapEl) {
                return;
            }
            if (groupBaseLabelEl) {
                const base = (state.groupState.groupKeys || []).map((k) => normalizeLabel(state.columnDefinitions[k] || k));
                groupBaseLabelEl.textContent = base.length ? `Base: ${base.join(' · ')}` : 'Base: none';
            }
            if (!state.groupState.groupKeys.length) {
                groupTableWrapEl.innerHTML = '<p class="px-4 py-6 text-xs text-slate-400 italic text-center">Select at least one column above to see grouped data.</p>';
                return;
            }

            const grouped = getChartSourceDataset();
            const summary = grouped.rows || [];
            const allPlMetricCols = (grouped.columns || []).filter((c) => String(c).startsWith('__plcnt_'));
            const metricCols = getVisibleGroupMetricCols(allPlMetricCols);

            if (!summary.length) {
                groupTableWrapEl.innerHTML = '<p class="px-4 py-6 text-xs text-slate-400 italic text-center">No data to group.</p>';
                return;
            }

            const table = document.createElement('table');
            table.className = 'min-w-full text-xs';

            const thead = document.createElement('thead');
            const headRow = document.createElement('tr');
            headRow.className = 'bg-slate-50 sticky top-0';

            state.groupState.groupKeys.forEach((k) => {
                const th = document.createElement('th');
                th.className = 'text-left px-3 py-2 font-semibold text-slate-700 whitespace-nowrap border-b border-slate-200';
                th.textContent = normalizeLabel(state.columnDefinitions[k] || k);
                headRow.appendChild(th);
            });

            const countTh = document.createElement('th');
            countTh.className = 'text-right px-3 py-2 font-semibold text-slate-700 whitespace-nowrap border-b border-slate-200';
            countTh.textContent = 'Count';
            headRow.appendChild(countTh);

            metricCols.forEach((c) => {
                const th = document.createElement('th');
                th.className = 'text-right px-3 py-2 font-semibold text-slate-700 whitespace-nowrap border-b border-slate-200';
                const raw = normalizeLabel((grouped.columnDefinitions && grouped.columnDefinitions[c]) || state.columnDefinitions[c] || c);
                th.textContent = raw.length > 26 ? `${raw.slice(0, 24)}…` : raw;
                th.title = raw;
                headRow.appendChild(th);
            });

            const actionTh = document.createElement('th');
            actionTh.className = 'px-3 py-2 border-b border-slate-200';
            headRow.appendChild(actionTh);

            thead.appendChild(headRow);
            table.appendChild(thead);

            const tbody = document.createElement('tbody');
            tbody.className = 'divide-y divide-slate-100';

            summary.slice(0, 200).forEach((groupRow) => {
                const tr = document.createElement('tr');
                tr.className = 'hover:bg-blue-50 cursor-pointer transition-colors group';

                const keyParts = state.groupState.groupKeys.map((k) => String(groupRow[k] ?? '(Blank)'));
                keyParts.forEach((val) => {
                    const td = document.createElement('td');
                    td.className = 'px-3 py-2 text-slate-800 whitespace-nowrap';
                    td.textContent = val;
                    tr.appendChild(td);
                });

                const countTd = document.createElement('td');
                countTd.className = 'px-3 py-2 text-right font-semibold text-slate-700';
                countTd.textContent = Number(groupRow.__group_count || 0).toLocaleString();
                tr.appendChild(countTd);

                metricCols.forEach((c) => {
                    const td = document.createElement('td');
                    td.className = 'px-3 py-2 text-right text-slate-600';
                    const val = Number(groupRow[c] || 0);
                    td.textContent = val.toLocaleString();
                    tr.appendChild(td);
                });

                const btnTd = document.createElement('td');
                btnTd.className = 'px-3 py-2 text-center';
                const btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'text-[11px] font-semibold text-blue-600 hover:text-blue-900 border border-blue-200 rounded px-2 py-0.5 hover:bg-blue-50 transition-colors whitespace-nowrap opacity-0 group-hover:opacity-100';
                btn.textContent = 'Filter ▸';
                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    setGroupFilter(keyParts, state.groupState.groupKeys);
                });
                btnTd.appendChild(btn);
                tr.appendChild(btnTd);

                tr.addEventListener('click', () => setGroupFilter(keyParts, state.groupState.groupKeys));
                tbody.appendChild(tr);
            });

            if (summary.length > 200) {
                const tr = document.createElement('tr');
                const td = document.createElement('td');
                td.colSpan = state.groupState.groupKeys.length + metricCols.length + 2;
                td.className = 'px-3 py-2 text-center text-[11px] text-slate-400 italic';
                td.textContent = `Showing 200 of ${summary.length.toLocaleString()} groups`;
                tr.appendChild(td);
                tbody.appendChild(tr);
            }

            table.appendChild(tbody);
            groupTableWrapEl.innerHTML = '';
            groupTableWrapEl.appendChild(table);
        }

        function buildGroupByUI() {
            if (!groupByTagsEl) {
                return;
            }

            state.groupState.groupKeys = [];
            groupByTagsEl.innerHTML = '';

            const eligibleCols = state.columns.filter((col) => {
                if ((state.columnTypes[col] || 'string') !== 'string') {
                    return false;
                }

                const distinct = new Set();
                for (const row of state.rows) {
                    distinct.add(isBlankValue(row[col]) ? '(Blank)' : String(row[col]));
                    if (distinct.size > 50) {
                        return false;
                    }
                }
                return distinct.size >= 2;
            });

            if (!eligibleCols.length) {
                groupByTagsEl.innerHTML = '<p class="text-xs text-slate-400 italic">No suitable group columns in this dataset.</p>';
                return;
            }

            eligibleCols.forEach((col) => {
                const label = normalizeLabel(state.columnDefinitions[col] || col);
                const cbId = `dv-gb-${col.replace(/[^a-z0-9]/gi, '_')}`;

                const tag = document.createElement('label');
                tag.htmlFor = cbId;
                tag.className = 'flex items-center gap-1.5 px-2.5 py-1 rounded-full border cursor-pointer select-none text-xs font-semibold border-slate-300 text-slate-600 hover:border-blue-400 hover:text-blue-700 bg-white transition-colors';
                tag.title = label;

                const cb = document.createElement('input');
                cb.type = 'checkbox';
                cb.id = cbId;
                cb.value = col;
                cb.className = 'sr-only';

                const span = document.createElement('span');
                span.textContent = label.length > 22 ? label.slice(0, 20) + '…' : label;

                cb.addEventListener('change', () => {
                    if (cb.checked) {
                        if (state.groupState.groupKeys.length >= 3) {
                            cb.checked = false;
                            return;
                        }
                        state.groupState.groupKeys.push(col);
                        tag.classList.add('border-blue-500', 'text-blue-700', 'bg-blue-50');
                        tag.classList.remove('border-slate-300', 'text-slate-600', 'bg-white');
                    } else {
                        state.groupState.groupKeys = state.groupState.groupKeys.filter((k) => k !== col);
                        tag.classList.remove('border-blue-500', 'text-blue-700', 'bg-blue-50');
                        tag.classList.add('border-slate-300', 'text-slate-600', 'bg-white');
                    }
                    renderGroupSummary();
                    if (state.chartSource === 'group') {
                        state.groupSeriesCols = [];
                        state.chartXCols = [];
                        state.chartGroupByCols = [];
                        renderGroupByChips();
                        syncControlsForChartType();
                        autoRenderChart();
                    }
                });

                tag.appendChild(cb);
                tag.appendChild(span);
                groupByTagsEl.appendChild(tag);
            });
        }

        function getChartConfig() {
            const effectiveAgg = aggEl.value || 'count';
            // Build multi-dimensional x_cols: primary X + any group-level additions
            const primaryX = xColEl.value || '';
            const extraGroupCols = (state.chartGroupByCols || []).filter(Boolean);
            const xCols = primaryX
                ? [primaryX, ...extraGroupCols]
                : (extraGroupCols.length ? extraGroupCols : []);
            return {
                chart_type: chartTypeEl.value || 'bar',
                x_col: primaryX,
                x_cols: xCols,
                y_col: yColEl.value || '',
                y_cols: state.groupSeriesCols.slice(),
                stack_col: stackColEl.value || '',
                size_col: sizeColEl.value || '',
                agg: effectiveAgg,
                title: styleState.title || '',
                palette: styleState.palette || 'default',
                background: styleState.background || 'white',
                legend_pos: styleState.legendPos || 'bottom',
                data_labels: !!styleState.dataLabels,
                smooth: !!styleState.smooth,
                show_points: !!styleState.showPoints,
                bins: Number(styleState.bins) || 12,
                curve: styleState.curve || 'linear',
                point_size: Number(styleState.pointSize) || 6,
                opacity: Number(styleState.opacity) || 0.9,
                zoom_pan: !!styleState.zoomPan,
                line_width: Number(styleState.lineWidth) || 2,
                border_radius: Number(styleState.borderRadius) || 6,
                stacking_mode: styleState.stackMode === 'percent' ? 'percent' : 'normal',
                tooltip_shared: !!styleState.tooltipShared,
                animate: !!styleState.animate,
                inverted: !!styleState.inverted,
                polar: !!styleState.polar,
                source: 'dataset',
            };
        }

        function getChartRequiredColumns(chartConfig) {
            const cols = new Set();
            [chartConfig.x_col, chartConfig.y_col, chartConfig.stack_col, chartConfig.size_col].forEach((c) => {
                if (c) {
                    cols.add(c);
                }
            });

            (chartConfig.x_cols || []).forEach((c) => {
                if (c) {
                    cols.add(c);
                }
            });

            (chartConfig.y_cols || []).forEach((c) => {
                if (c) {
                    cols.add(c);
                }
            });

            // also include any extra group-by cols
            (state.chartGroupByCols || []).forEach((c) => {
                if (c) cols.add(c);
            });

            return Array.from(cols);
        }

        function projectRowsForChart(rows, requiredColumns) {
            if (!requiredColumns.length) {
                return rows;
            }
            return rows.map((row) => {
                const next = {};
                requiredColumns.forEach((c) => {
                    next[c] = row[c];
                });
                return next;
            });
        }

        async function renderChart() {
            if (!renderChartUrl) {
                loadStatus.textContent = 'Render API URL missing';
                return;
            }

            if (!chartTypeEl.value) {
                return;
            }

            const chartDataset = getChartSourceDataset();
            const activeRows = chartDataset.rows;

            if (!activeRows.length) {
                if (chartRenderer) {
                    chartRenderer.showMessage(chartDataset.groupError || 'No rows to render', false);
                }
                return;
            }

            const reqId = ++chartRequestNonce;
            renderBtn.disabled = true;
            loadStatus.textContent = 'Rendering chart...';

            try {
                const chartConfig = getChartConfig();
                const requiredColumns = getChartRequiredColumns(chartConfig);
                const chartRows = projectRowsForChart(activeRows, requiredColumns);

                const response = await fetch(renderChartUrl, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'X-CSRFToken': csrfToken,
                    },
                    body: JSON.stringify({
                        rows: chartRows,
                        column_definitions: chartDataset.columnDefinitions,
                        chart_config: chartConfig,
                    }),
                });

                const payload = await readJsonResponse(response, 'Chart API');
                if (!response.ok || !payload.option) {
                    throw new Error(payload.error || 'Failed to render chart');
                }

                if (reqId !== chartRequestNonce) {
                    return;
                }

                if (chartRenderer) {
                    chartRenderer.render(payload.option);
                }

                loadStatus.textContent = `Rendered ${activeRows.length.toLocaleString()} rows`;
            } catch (error) {
                loadStatus.textContent = 'Could not render chart';
                if (chartRenderer) {
                    chartRenderer.showMessage(String(error.message || error), true);
                }
            } finally {
                renderBtn.disabled = false;
            }
        }

        function autoRenderChart() {
            if (renderBtn.disabled || !state.columns.length) {
                return;
            }
            renderChart();
        }

        function setLoadProgress(pct, msg) {
            if (loadProgressWrap) loadProgressWrap.classList.remove('hidden');
            if (loadProgressBar)  loadProgressBar.style.width = pct + '%';
            if (loadStatus)       loadStatus.textContent = msg || '';
        }

        function resetLoadUI() {
            if (loadProgressWrap) loadProgressWrap.classList.add('hidden');
            if (loadProgressBar)  loadProgressBar.style.width = '0%';
            if (loadSummaryEl)    loadSummaryEl.classList.add('hidden');
            if (loadBtnIcon)      loadBtnIcon.textContent = '\u25B6';
            if (loadBtnText)      loadBtnText.textContent = 'Load Dataset';
        }

        async function loadDataset() {
            loadBtn.disabled = true;
            resetLoadUI();
            if (loadBtnIcon) loadBtnIcon.innerHTML = '<svg class="animate-spin" style="width:12px;height:12px;display:inline" viewBox="0 0 24 24" fill="none"><circle cx="12" cy="12" r="10" stroke="currentColor" stroke-width="3" stroke-dasharray="31.4" stroke-dashoffset="10"/></svg>';
            if (loadBtnText) loadBtnText.textContent = 'Loading...';
            setLoadProgress(10, 'Connecting...');

            const params = new URLSearchParams();
            params.set('format', 'json');
            params.set('limit', '1500');

            const hasSavedQuery = savedQueryEl && savedQueryEl.value;

            if (hasSavedQuery) {
                // Let the backend use the saved query's column list;
                // only override if the user also explicitly ticked columns.
                const uiCols = getSelectedColumns();
                const opt = savedQueryEl.options[savedQueryEl.selectedIndex];
                let sqCols = [];
                try { sqCols = (JSON.parse((opt && opt.dataset.config) || '{}')).columns || []; } catch (_) {}
                // Only send columns param when the user has diverged from the saved-query default
                const uiSet = JSON.stringify(uiCols.slice().sort());
                const sqSet = JSON.stringify(sqCols.slice().sort());
                if (uiCols.length && uiSet !== sqSet) {
                    params.set('columns', JSON.stringify(uiCols));
                }
                params.set('saved_query', savedQueryEl.value);
            } else {
                const selectedColumns = getSelectedColumns();
                if (selectedColumns.length) {
                    params.set('columns', JSON.stringify(selectedColumns));
                }
            }
            if (searchEl && searchEl.value.trim()) {
                params.set('search', searchEl.value.trim());
            }
            if (schoolYearEl && schoolYearEl.value.trim()) {
                params.set('school_year', schoolYearEl.value.trim());
            }
            if (gradeEl && gradeEl.value.trim()) {
                params.set('grade', gradeEl.value.trim());
            }
            if (statusEl && statusEl.value !== null) {
                params.set('status', statusEl.value);
            }

            try {
                setLoadProgress(20, 'Fetching page 1...');
                const firstResponse = await fetch(`${loadStudentsUrl}?${params.toString()}`);
                const firstPayload = await readJsonResponse(firstResponse, 'Students API (page 1)');

                if (!firstResponse.ok || !firstPayload.students) {
                    throw new Error('Failed to load dataset');
                }

                const allRows = Array.isArray(firstPayload.students) ? firstPayload.students.slice() : [];
                let mergedDefinitions = { ...(firstPayload.column_definitions || {}) };
                const totalPages = Math.max(1, Number(firstPayload.total_pages || 1));
                setLoadProgress(20 + Math.round(60 / totalPages), `Page 1 of ${totalPages} • ${allRows.length.toLocaleString()} rows`);

                for (let pageNum = 2; pageNum <= totalPages; pageNum += 1) {
                    const pageParams = new URLSearchParams(params.toString());
                    pageParams.set('page', String(pageNum));
                    const pct = 20 + Math.round((pageNum / totalPages) * 60);
                    setLoadProgress(pct, `Page ${pageNum} of ${totalPages} • ${allRows.length.toLocaleString()} rows loaded...`);

                    const pageResponse = await fetch(`${loadStudentsUrl}?${pageParams.toString()}`);
                    const pagePayload = await readJsonResponse(pageResponse, `Students API (page ${pageNum})`);
                    if (!pageResponse.ok || !Array.isArray(pagePayload.students)) {
                        throw new Error(`Failed to load page ${pageNum}`);
                    }

                    allRows.push(...pagePayload.students);
                    mergedDefinitions = { ...mergedDefinitions, ...(pagePayload.column_definitions || {}) };
                    setLoadProgress(pct + Math.round(60 / totalPages), `Page ${pageNum} of ${totalPages} • ${allRows.length.toLocaleString()} rows...`);
                }

                state.rows = allRows;
                state.columns = firstPayload.selected_columns || (allRows[0] ? Object.keys(allRows[0]) : []);
                state.columnDefinitions = { ...state.columnDefinitions, ...mergedDefinitions };

                state.columnTypes = {};
                state.columns.forEach((column) => {
                    const values = state.rows.map((row) => row[column]);
                    state.columnTypes[column] = inferColumnType(values);
                });

                state.columns.forEach((column) => {
                    if (column.endsWith('_PL')) {
                        state.columnTypes[column] = 'string';
                    } else if (column.endsWith('_SS')) {
                        state.columnTypes[column] = 'number';
                    } else if (String(column).toLowerCase() === 'grade') {
                        state.columnTypes[column] = 'string';
                    }
                });

                // ── Inject synthetic meta-columns for assessment analysis ────────────────
                // When test/mark columns are present the backend can melt them into long
                // form. These synthetic column names trigger that melt and appear in all
                // dropdowns as selectable dimensions/values.
                //
                // For tests the label format is:  "Name Subject (YYYY-YYYY) SS[\nWindow]"
                // For marks:                       "Course (Subject) Period\nYYYY-YYYY"

                const _testSsCols = state.columns.filter(
                    (c) => /^test_\d{4}_\d{4}_/.test(c) && c.endsWith('_SS'),
                );
                const _markCols = state.columns.filter((c) => /^mark_\d{4}_\d{4}_/.test(c));

                if (_testSsCols.length > 0 || _markCols.length > 0) {
                    // Parse assessment display names from col_defs so the _assessment
                    // dropdown shows recognisable names (not raw keys).
                    const _yearRe = /\((\d{4}-\d{4})\)/;
                    const _assessmentNames = new Set();

                    _testSsCols.forEach((c) => {
                        const lbl = (state.columnDefinitions[c] || '').split('\n')[0];
                        const ym = lbl.match(_yearRe);
                        if (ym) {
                            let name = lbl.slice(0, ym.index).trim();
                            for (const sfx of [' SS', ' PL', ' Scale Score', ' Perf Lvl']) {
                                if (name.endsWith(sfx)) { name = name.slice(0, -sfx.length).trim(); break; }
                            }
                            if (name) _assessmentNames.add(name);
                        }
                    });
                    _markCols.forEach((c) => {
                        const lbl = (state.columnDefinitions[c] || '').split('\n')[0];
                        if (lbl.includes(' (')) {
                            const name = lbl.slice(0, lbl.lastIndexOf(' (')).trim();
                            if (name) _assessmentNames.add(name);
                        }
                    });

                    // Build a human-readable hint for the _assessment column
                    const _assessList = [..._assessmentNames].sort();
                    const _assessHint = _assessList.length
                        ? `Assessment (${_assessList.slice(0, 3).join(', ')}${_assessList.length > 3 ? '…' : ''})`
                        : 'Assessment';

                    [
                        ['_assessment',       'string',  _assessHint],
                        ['_test_school_year', 'string',  'Test School Year'],
                        ['_test_window',      'string',  'Test Window / Period'],
                        ['_test_score',       'number',  'Test Score (SS)'],
                        ['_mark_school_year', 'string',  'Mark School Year'],
                        ['_mark_period',      'string',  'Mark Period'],
                        ['_mark_score',       'number',  'Mark Value'],
                    ].forEach(([col, type, label]) => {
                        if (!state.columns.includes(col)) state.columns.push(col);
                        state.columnTypes[col] = type;
                        state.columnDefinitions[col] = label;
                    });
                }

                state.filterState = { search: '', columns: {} };
                state.filteredRows = state.rows.slice();
                state.previewPage = 1;

                if (emptyState)        emptyState.classList.add('hidden');
                if (chartWrap)         chartWrap.classList.remove('hidden');
                if (chartControlsWrap) chartControlsWrap.classList.remove('opacity-40');

                [xColEl, yColEl, stackColEl, aggEl, renderBtn, chartTypeEl, chartSourceEl].forEach((el) => {
                    if (el) {
                        el.disabled = false;
                    }
                });
                setLoadProgress(85, 'Building chart columns...');
                buildRecommendations();
                updateChartTypeOptions();
                syncControlsForChartType();
                buildFilterBar();
                renderPreview();
                updateBuildAssistant();
                state.chartGroupByCols = [];
                renderGroupByChips();
                buildDimMetricPanels();   // directly rebuild DIMENSIONS / METRICS chips
                renderChart();
                setLoadProgress(100, '');

                const totalRows = firstPayload.total || state.rows.length;
                const numCols   = state.columns.length;
                const assessCols = state.columns.filter(function (c) { return c.startsWith('test_') || c.startsWith('mark_') || c.startsWith('_test') || c.startsWith('_mark'); }).length;
                const summaryMsg = totalRows.toLocaleString() + ' rows • '
                    + numCols + ' columns'
                    + (assessCols > 0 ? ' • ' + assessCols + ' assess.' : '');

                if (loadStatus)      loadStatus.textContent = '';
                if (loadSummaryEl)   loadSummaryEl.classList.remove('hidden');
                if (loadSummaryText) loadSummaryText.textContent = '\u2713 ' + summaryMsg;
                if (loadBtnIcon)     loadBtnIcon.textContent = '\u2713';
                if (loadBtnText)     loadBtnText.textContent = 'Reload';

                // fade progress bar out after a moment
                setTimeout(function () {
                    if (loadProgressWrap) loadProgressWrap.classList.add('hidden');
                }, 800);

            } catch (err) {
                setLoadProgress(0, '');
                if (loadProgressWrap) loadProgressWrap.classList.add('hidden');
                if (loadStatus)   loadStatus.textContent = '\u26A0 ' + (err.message || 'Could not load dataset');
                if (loadBtnIcon)  loadBtnIcon.textContent = '\u9654';
                if (loadBtnText)  loadBtnText.textContent = 'Retry';
                if (loadSummaryEl) loadSummaryEl.classList.add('hidden');
            } finally {
                loadBtn.disabled = false;
            }
        }

        window.addEventListener('resize', () => {
            if (chartRenderer) {
                chartRenderer.resize();
            }
        });

        if (typeof ResizeObserver !== 'undefined' && chartEl) {
            new ResizeObserver(() => {
                if (chartRenderer) {
                    chartRenderer.resize();
                }
            }).observe(chartEl);
        }

        if (tabDataBtn) {
            tabDataBtn.addEventListener('click', () => switchTab('data'));
        }
        if (tabSummaryBtn) {
            tabSummaryBtn.addEventListener('click', () => switchTab('summary'));
        }

        if (groupFilterClearEl) {
            groupFilterClearEl.addEventListener('click', () => {
                state.groupState.groupKeys.forEach((k) => {
                    delete state.filterState.columns[k];
                });

                buildFilterBar();

                if (groupFilterBadgeEl) {
                    groupFilterBadgeEl.classList.add('hidden');
                    groupFilterBadgeEl.classList.remove('flex');
                }

                applyFilters();
            });
        }

        // ── Column count badge ─────────────────────────────────────────────────
        const colCountBadgeEl = document.getElementById('dv-col-count-badge');
        const loadProgressWrap = document.getElementById('dv-load-progress-wrap');
        const loadProgressBar  = document.getElementById('dv-load-progress-bar');
        const loadSummaryEl    = document.getElementById('dv-load-summary');
        const loadSummaryText  = document.getElementById('dv-load-summary-text');
        const loadBtnIcon      = document.getElementById('dv-load-btn-icon');
        const loadBtnText      = document.getElementById('dv-load-btn-text');

        function updateColCount() {
            const checked = document.querySelectorAll('.dv-col:checked, input[data-column]:checked').length;
            if (colCountBadgeEl) {
                colCountBadgeEl.textContent = checked;
                colCountBadgeEl.className = checked > 0
                    ? 'ml-1 px-1.5 py-0.5 rounded-full bg-blue-100 text-blue-700 text-[9px] font-black'
                    : 'ml-1 px-1.5 py-0.5 rounded-full bg-slate-200 text-slate-400 text-[9px] font-black';
            }
        }

        // Wire all existing checkboxes and watch for DOM additions (assessment tree)
        function wireColCheckboxes() {
            document.querySelectorAll('.dv-col, input[data-column]').forEach(function (inp) {
                if (!inp._colCountWired) {
                    inp._colCountWired = true;
                    inp.addEventListener('change', updateColCount);
                }
            });
            updateColCount();
        }
        wireColCheckboxes();
        // Re-wire after accordion opens (lazy-rendered assessment checkboxes)
        const colAccordion = document.getElementById('dv-col-accordion');
        if (colAccordion) {
            colAccordion.addEventListener('toggle', wireColCheckboxes);
        }

        // Per-category "all" toggle
        document.querySelectorAll('.dv-cat-toggle').forEach(function (btn) {
            btn.addEventListener('click', function () {
                const cat = btn.dataset.category;
                const boxes = document.querySelectorAll('.dv-col[data-cat="' + cat + '"]');
                const allChecked = Array.from(boxes).every(function (b) { return b.checked; });
                boxes.forEach(function (b) { b.checked = !allChecked; });
                btn.textContent = allChecked ? 'all' : 'none';
                updateColCount();
            });
        });

        // Clear all
        const colClearAllBtn = document.getElementById('dv-col-clear-all');
        if (colClearAllBtn) {
            colClearAllBtn.addEventListener('click', function () {
                document.querySelectorAll('.dv-col, input[data-column]').forEach(function (inp) { inp.checked = false; });
                updateColCount();
            });
        }

        // "Core Columns" = apply defaults
        const colSelectAllBtn = document.getElementById('dv-col-select-all');
        if (colSelectAllBtn) {
            colSelectAllBtn.addEventListener('click', function () {
                applyDefaultColumns();
                updateColCount();
            });
        }

        if (useDefaultBtn) {
            useDefaultBtn.addEventListener('click', function () {
                applyDefaultColumns();
                updateColCount();
            });
        }

        // ── CUSTOM COLUMN GROUPS ────────────────────────────────────────────────
        let _customColGroups = [];

        const addColGroupBtnEl   = document.getElementById('dv-add-col-group-btn');
        const addColGroupModalEl = document.getElementById('dv-add-col-group-modal');
        const colGroupNameEl     = document.getElementById('dv-col-group-name');
        const colGroupColListEl  = document.getElementById('dv-col-group-col-list');
        const colGroupManualEl   = document.getElementById('dv-col-group-manual');
        const colGroupErrorEl    = document.getElementById('dv-col-group-error');
        const colGroupCancelEl   = document.getElementById('dv-col-group-cancel');
        const colGroupConfirmEl  = document.getElementById('dv-col-group-confirm');
        const customColGroupsEl  = document.getElementById('dv-custom-col-groups');

        function openAddColGroupModal() {
            if (!addColGroupModalEl) return;
            if (colGroupNameEl) colGroupNameEl.value = '';
            if (colGroupManualEl) colGroupManualEl.value = '';
            if (colGroupErrorEl) {
                colGroupErrorEl.textContent = '';
                colGroupErrorEl.classList.add('hidden');
            }
            if (colGroupColListEl) {
                if (!state.columns.length) {
                    colGroupColListEl.innerHTML = '<p class="text-[11px] text-slate-400 italic">Load a dataset first to see available columns here.</p>';
                } else {
                    colGroupColListEl.innerHTML = '';
                    state.columns.forEach(function (col) {
                        var label = colDisplayLabel ? colDisplayLabel(col) : col;
                        var lbl = document.createElement('label');
                        lbl.className = 'flex items-center gap-1.5 px-1 py-0.5 rounded hover:bg-blue-50 cursor-pointer';
                        lbl.innerHTML = '<input type="checkbox" class="cg-pick rounded border-slate-300 text-blue-600 w-3 h-3 shrink-0" value="' + escapeHtml(col) + '">'
                            + '<span class="text-[11px] text-slate-700 leading-tight">' + escapeHtml(label) + '</span>';
                        colGroupColListEl.appendChild(lbl);
                    });
                }
            }
            addColGroupModalEl.classList.add('open');
        }

        function closeAddColGroupModal() {
            if (addColGroupModalEl) addColGroupModalEl.classList.remove('open');
        }

        function renderCustomGroupInAccordion(group) {
            if (!customColGroupsEl) return;
            var catKey = 'custom_' + group.id;
            var details = document.createElement('details');
            details.className = 'rounded border border-slate-100';
            details.dataset.customGroupId = group.id;
            details.setAttribute('open', '');

            var header = document.createElement('summary');
            header.className = 'flex items-center justify-between px-2 py-1 bg-slate-50 rounded-t cursor-pointer list-none';
            header.innerHTML = '<span class="text-[9px] font-black uppercase tracking-widest text-slate-500">' + escapeHtml(group.name) + '</span>'
                + '<div class="flex items-center gap-1">'
                + '<button type="button" class="cg-all-btn text-[9px] text-blue-500 hover:text-blue-800">all</button>'
                + '<button type="button" class="cg-del-btn text-[9px] text-red-400 hover:text-red-600 ml-1" title="Remove group">\u2715</button>'
                + '</div>';

            var body = document.createElement('div');
            body.className = 'px-1 py-1 space-y-0';
            group.columns.forEach(function (col) {
                var label = colDisplayLabel ? colDisplayLabel(col) : col;
                var lbl = document.createElement('label');
                lbl.className = 'flex items-start gap-1.5 px-1 py-0.5 rounded hover:bg-blue-50 cursor-pointer';
                lbl.innerHTML = '<input type="checkbox" class="dv-col rounded border-slate-300 text-blue-600 w-3 h-3 mt-0.5 shrink-0" value="' + escapeHtml(col) + '" data-cat="' + escapeHtml(catKey) + '" data-column="' + escapeHtml(col) + '">'
                    + '<span class="text-[11px] text-slate-700 leading-tight">' + escapeHtml(label) + '</span>';
                lbl.querySelector('input').addEventListener('change', updateColCount);
                body.appendChild(lbl);
            });

            // All/None toggle
            header.querySelector('.cg-all-btn').addEventListener('click', function (e) {
                e.preventDefault();
                var boxes = body.querySelectorAll('.dv-col');
                var allChecked = Array.from(boxes).every(function (b) { return b.checked; });
                boxes.forEach(function (b) { b.checked = !allChecked; });
                updateColCount();
            });

            // Delete group
            header.querySelector('.cg-del-btn').addEventListener('click', function (e) {
                e.preventDefault();
                _customColGroups = _customColGroups.filter(function (g) { return g.id !== group.id; });
                details.remove();
                updateColCount();
            });

            details.appendChild(header);
            details.appendChild(body);
            customColGroupsEl.appendChild(details);
        }

        if (addColGroupBtnEl) {
            addColGroupBtnEl.addEventListener('click', openAddColGroupModal);
        }
        if (colGroupCancelEl) {
            colGroupCancelEl.addEventListener('click', closeAddColGroupModal);
        }
        if (colGroupConfirmEl) {
            colGroupConfirmEl.addEventListener('click', function () {
                var name = colGroupNameEl ? colGroupNameEl.value.trim() : '';
                if (!name) {
                    if (colGroupErrorEl) {
                        colGroupErrorEl.textContent = 'Group name is required.';
                        colGroupErrorEl.classList.remove('hidden');
                    }
                    return;
                }
                var pickedCols = colGroupColListEl
                    ? Array.from(colGroupColListEl.querySelectorAll('.cg-pick:checked')).map(function (cb) { return cb.value; })
                    : [];
                var manualCols = colGroupManualEl && colGroupManualEl.value.trim()
                    ? colGroupManualEl.value.split(',').map(function (s) { return s.trim(); }).filter(Boolean)
                    : [];
                var allCols = Array.from(new Set(pickedCols.concat(manualCols)));
                if (!allCols.length) {
                    if (colGroupErrorEl) {
                        colGroupErrorEl.textContent = 'Select at least one column.';
                        colGroupErrorEl.classList.remove('hidden');
                    }
                    return;
                }
                var group = { id: Date.now(), name: name, columns: allCols };
                _customColGroups.push(group);
                renderCustomGroupInAccordion(group);
                updateColCount();
                closeAddColGroupModal();
            });
        }
        // ── END CUSTOM COLUMN GROUPS ────────────────────────────────────────────

        // ── Saved-query auto-populate ──────────────────────────────────────────
        if (savedQueryEl) {
            savedQueryEl.addEventListener('change', function () {
                const opt = savedQueryEl.options[savedQueryEl.selectedIndex];
                const badge = document.getElementById('dv-query-badge');

                if (!opt || !opt.value) {
                    if (badge) { badge.textContent = ''; badge.classList.add('hidden'); }
                    return;
                }

                let cfg = {};
                try { cfg = JSON.parse(opt.dataset.config || '{}'); } catch (_) {}

                const qType = opt.dataset.queryType || 'filter';
                const filters = cfg.filters || {};

                // Pre-fill standard filter inputs
                if (searchEl)     searchEl.value     = filters.search     || cfg.search     || '';
                if (schoolYearEl) schoolYearEl.value = filters.school_year || cfg.school_year || '';
                if (gradeEl)      gradeEl.value      = filters.grade      || cfg.grade      || '';
                if (statusEl)     statusEl.value     = filters.status     || cfg.status     || 'Active';

                // Pre-check column checkboxes from saved query columns list
                const savedCols = cfg.columns || [];
                if (savedCols.length) {
                    const colSet = new Set(savedCols);
                    document.querySelectorAll('.dv-col, input[data-column]').forEach(function (inp) {
                        const key = inp.dataset.column || inp.value;
                        inp.checked = colSet.has(key);
                    });
                    wireColCheckboxes();
                    updateColCount();
                }

                // Badge
                if (badge) {
                    if (qType === 'student_list') {
                        const count = (cfg.student_ids || []).length;
                        badge.textContent = '\u2713 Student list (' + count + ' students)';
                    } else {
                        const colCount = (cfg.columns || []).length;
                        badge.textContent = '\u2713 Query loaded' + (colCount ? ' \u2022 ' + colCount + ' columns' : '');
                    }
                    badge.classList.remove('hidden');
                }
            });
        }

        if (loadBtn) {
            loadBtn.addEventListener('click', loadDataset);
        }
        if (renderBtn) {
            renderBtn.addEventListener('click', renderChart);
        }

        if (previewPrevBtn) {
            previewPrevBtn.addEventListener('click', () => {
                if (state.previewPage > 1) {
                    state.previewPage -= 1;
                    renderPreview();
                }
            });
        }

        if (previewNextBtn) {
            previewNextBtn.addEventListener('click', () => {
                const totalRows = getActiveRows().length;
                const totalPages = Math.max(1, Math.ceil(totalRows / (state.previewPageSize || 100)));
                if (state.previewPage < totalPages) {
                    state.previewPage += 1;
                    renderPreview();
                }
            });
        }

        chartTypeEl.addEventListener('change', function () {
            syncControlsForChartType();
            updateChartTypeHelp();
            updateBuildAssistant();
            autoRenderChart();
        });

        // Re-sync agg options whenever the Y column changes so numeric-only
        // aggs (sum/avg/min/max/median) are shown or hidden based on the
        // actual selected column type.
        yColEl.addEventListener('change', function () {
            syncControlsForChartType();
            autoRenderChart();
        });

        if (chartSourceEl) {
            chartSourceEl.addEventListener('change', () => {
                state.chartSource = chartSourceEl.value || 'dataset';
                state.groupSeriesCols = [];
                state.chartXCols = [];
                state.chartGroupByCols = [];
                renderGroupByChips();
                if (aggEl) {
                    if (state.chartSource === 'group') {
                        aggEl.value = 'sum';
                    }
                }
                updateChartTypeOptions();
                syncControlsForChartType();
                updateBuildAssistant();
                autoRenderChart();
            });
        }


        if (groupMetricModeEl) {
            state.groupReport.metricMode = groupMetricModeEl.value || 'all';
            groupMetricModeEl.addEventListener('change', () => {
                state.groupReport.metricMode = groupMetricModeEl.value || 'all';
                renderGroupSummary();
            });
        }

        if (groupViewModeEl) {
            state.groupReport.viewMode = groupViewModeEl.value || 'table';
            groupViewModeEl.addEventListener('change', () => {
                state.groupReport.viewMode = groupViewModeEl.value || 'table';
            });
        }

        if (groupApplyViewBtn) {
            groupApplyViewBtn.addEventListener('click', () => {
                applyGroupReportViewToChart();
            });
        }

        [xColEl, yColEl, stackColEl, sizeColEl, aggEl].forEach((control) => {
            control.addEventListener('change', () => {
                if (control === xColEl) {
                    if (!state.chartXCols.length) {
                        state.chartXCols = [xColEl.value].filter(Boolean);
                    } else if (!state.chartXCols.includes(xColEl.value)) {
                        state.chartXCols[0] = xColEl.value;
                    }
                }
                autoRenderChart();
            });
        });

        let titleTimer;
        if (optTitleEl) {
            optTitleEl.addEventListener('input', () => {
                clearTimeout(titleTimer);
                titleTimer = setTimeout(() => {
                    styleState.title = optTitleEl.value.trim();
                    autoRenderChart();
                }, 300);
            });
        }
        if (optPaletteEl) {
            optPaletteEl.addEventListener('change', () => {
                styleState.palette = optPaletteEl.value;
                autoRenderChart();
            });
        }
        if (optBgEl) {
            optBgEl.addEventListener('change', () => {
                styleState.background = optBgEl.value;
                autoRenderChart();
            });
        }
        if (optLegendEl) {
            optLegendEl.addEventListener('change', () => {
                styleState.legendPos = optLegendEl.value;
                autoRenderChart();
            });
        }
        if (optLabelsEl) {
            optLabelsEl.addEventListener('change', () => {
                styleState.dataLabels = optLabelsEl.checked;
                autoRenderChart();
            });
        }
        if (optSmoothEl) {
            optSmoothEl.addEventListener('change', () => {
                styleState.smooth = optSmoothEl.checked;
                autoRenderChart();
            });
        }
        if (optMarkersEl) {
            optMarkersEl.addEventListener('change', () => {
                styleState.showPoints = optMarkersEl.checked;
                autoRenderChart();
            });
        }
        if (optBinsEl) {
            styleState.bins = Number(optBinsEl.value) || 12;
            optBinsEl.addEventListener('change', () => {
                styleState.bins = Number(optBinsEl.value) || 12;
                autoRenderChart();
            });
        }
        if (optCurveEl) {
            styleState.curve = optCurveEl.value || 'linear';
            optCurveEl.addEventListener('change', () => {
                styleState.curve = optCurveEl.value || 'linear';
                autoRenderChart();
            });
        }
        if (optPointSizeEl) {
            styleState.pointSize = Number(optPointSizeEl.value) || 6;
            optPointSizeEl.addEventListener('change', () => {
                styleState.pointSize = Number(optPointSizeEl.value) || 6;
                autoRenderChart();
            });
        }
        if (optOpacityEl) {
            styleState.opacity = Number(optOpacityEl.value) || 0.9;
            optOpacityEl.addEventListener('input', () => {
                styleState.opacity = Number(optOpacityEl.value) || 0.9;
                autoRenderChart();
            });
        }
        if (optZoomEl) {
            styleState.zoomPan = !!optZoomEl.checked;
            optZoomEl.addEventListener('change', () => {
                styleState.zoomPan = !!optZoomEl.checked;
                autoRenderChart();
            });
        }
        if (optLineWidthEl) {
            styleState.lineWidth = Number(optLineWidthEl.value) || 2;
            optLineWidthEl.addEventListener('change', () => {
                styleState.lineWidth = Number(optLineWidthEl.value) || 2;
                autoRenderChart();
            });
        }
        if (optRadiusEl) {
            styleState.borderRadius = Number(optRadiusEl.value) || 6;
            optRadiusEl.addEventListener('change', () => {
                styleState.borderRadius = Number(optRadiusEl.value) || 6;
                autoRenderChart();
            });
        }
        if (optStackModeEl) {
            styleState.stackMode = optStackModeEl.value || 'normal';
            optStackModeEl.addEventListener('change', () => {
                styleState.stackMode = optStackModeEl.value || 'normal';
                autoRenderChart();
            });
        }
        if (optTooltipSharedEl) {
            styleState.tooltipShared = !!optTooltipSharedEl.checked;
            optTooltipSharedEl.addEventListener('change', () => {
                styleState.tooltipShared = !!optTooltipSharedEl.checked;
                autoRenderChart();
            });
        }
        if (optAnimateEl) {
            styleState.animate = !!optAnimateEl.checked;
            optAnimateEl.addEventListener('change', () => {
                styleState.animate = !!optAnimateEl.checked;
                autoRenderChart();
            });
        }
        if (optInvertedEl) {
            styleState.inverted = !!optInvertedEl.checked;
            optInvertedEl.addEventListener('change', () => {
                styleState.inverted = !!optInvertedEl.checked;
                autoRenderChart();
            });
        }
        if (optPolarEl) {
            styleState.polar = !!optPolarEl.checked;
            optPolarEl.addEventListener('change', () => {
                styleState.polar = !!optPolarEl.checked;
                autoRenderChart();
            });
        }

        initTreeToggles();
        applyDefaultColumns();

        const axisPlaceholderHtml = '<option value="">— load dataset first —</option>';
        [xColEl, yColEl, stackColEl, sizeColEl].forEach((el) => {
            el.innerHTML = axisPlaceholderHtml;
            el.disabled = true;
        });
        aggEl.disabled = true;
        renderBtn.disabled = true;
        chartTypeEl.disabled = true;
        if (chartSourceEl) {
            chartSourceEl.disabled = true;
            state.chartSource = 'dataset';
        }

        updateChartTypeHelp();
        updateChartTypeOptions();
        if (!supportedCharts.includes(chartTypeEl.value)) {
            chartTypeEl.value = 'bar';
        }
        updateBuildAssistant();

        // ══════════════════════════════════════════════════════════════════
        // ── SUPERSET-STYLE EXTENSIONS ─────────────────────────────────────
        // ══════════════════════════════════════════════════════════════════

        const appDataEl      = document.getElementById('dataviz-app-data');
        const sqlUrl         = (appDataEl && appDataEl.dataset.sqlUrl)        || '';
        const schemaUrl      = (appDataEl && appDataEl.dataset.schemaUrl)     || '';
        const chartsUrl      = (appDataEl && appDataEl.dataset.chartsUrl)     || '';
        const saveChartUrl   = (appDataEl && appDataEl.dataset.saveChartUrl)  || '';
        const dashboardsUrl  = (appDataEl && appDataEl.dataset.dashboardsUrl) || '';

        // ─── Mode switching ───────────────────────────────────────────────
        const modeExploreBtnEl   = document.getElementById('dv-mode-explore');
        const modeSqlBtnEl       = document.getElementById('dv-mode-sql');
        const modeDashboardBtnEl = document.getElementById('dv-mode-dashboard');
        const explorePane        = document.getElementById('dv-explore-mode');
        const sqlPane            = document.getElementById('dv-sql-mode');
        const dashPane           = document.getElementById('dv-dashboard-mode');

        let appMode = 'explore';

        function switchMode(mode) {
            appMode = mode;
            [explorePane, sqlPane, dashPane].forEach((p) => { p && p.classList.remove('active'); });
            [modeExploreBtnEl, modeSqlBtnEl, modeDashboardBtnEl].forEach((b) => {
                if (!b) return;
                b.classList.remove('bg-blue-600', 'text-white');
                b.classList.add('text-slate-500');
            });
            const paneMap = { explore: explorePane, sql: sqlPane, dashboard: dashPane };
            const btnMap  = { explore: modeExploreBtnEl, sql: modeSqlBtnEl, dashboard: modeDashboardBtnEl };
            if (paneMap[mode]) paneMap[mode].classList.add('active');
            if (btnMap[mode]) {
                btnMap[mode].classList.add('bg-blue-600', 'text-white');
                btnMap[mode].classList.remove('text-slate-500');
            }
            if (mode === 'sql'       && !sqlSchemaLoaded)   { loadSqlSchema(); sqlSchemaLoaded = true; }
            if (mode === 'dashboard' && !dashboardsLoaded)  { loadDashboards(); dashboardsLoaded = true; }
        }

        let sqlSchemaLoaded   = false;
        let dashboardsLoaded  = false;

        if (modeExploreBtnEl)   modeExploreBtnEl.addEventListener('click',   () => switchMode('explore'));
        if (modeSqlBtnEl)       modeSqlBtnEl.addEventListener('click',       () => switchMode('sql'));
        if (modeDashboardBtnEl) modeDashboardBtnEl.addEventListener('click', () => switchMode('dashboard'));

        // ─── Dimension / Metric column classification ──────────────────────
        // Called after data loads to build the left-panel chips.

        const dimListEl      = document.getElementById('dv-dim-list');
        const metricListEl   = document.getElementById('dv-metric-list');
        const dimCountEl     = document.getElementById('dv-dim-count');
        const metricCountEl  = document.getElementById('dv-metric-count');
        const dimSearchEl    = document.getElementById('dv-dim-search');

        // Slot elements
        const slotXEl      = document.getElementById('dv-slot-x');
        const slotSeriesEl = document.getElementById('dv-slot-series');
        const slotYEl      = document.getElementById('dv-slot-y');
        const slotSizeEl   = document.getElementById('dv-slot-size');

        // Current slot assignments  { x: col|'', series: col|'', y: col|'', size: col|'' }
        const slotState = { x: '', series: '', y: '', size: '' };

        function colDisplayLabel(col) {
            const raw = state.columnDefinitions[col] || col;
            return String(raw).split('\n')[0].split(' — ')[0].trim().slice(0, 40);
        }

        function buildDimMetricPanels() {
            const cols = state.columns || [];
            const types = state.columnTypes || {};
            const searchQ = (dimSearchEl ? dimSearchEl.value.toLowerCase() : '');

            const dimCols    = [];
            const metricCols = [];
            const assessCols = [];

            cols.forEach((col) => {
                if (!col) return;
                const label = colDisplayLabel(col).toLowerCase();
                if (searchQ && !label.includes(searchQ) && !col.toLowerCase().includes(searchQ)) return;

                if (/^_assessment$/.test(col) || /^_test_|^_mark_/.test(col)) {
                    assessCols.push(col);
                    return;
                }
                if (types[col] === 'number') {
                    metricCols.push(col);
                } else {
                    dimCols.push(col);
                }
            });

            function makeChip(col, kind) {
                const isAssigned = Object.values(slotState).includes(col) && col !== '';
                const cls = kind === 'metric' ? 'metric' : (kind === 'assess' ? 'assessment' : 'dim');
                const icon = kind === 'metric' ? '∑' : (kind === 'assess' ? '★' : '◆');
                const lbl  = colDisplayLabel(col);
                const chip = document.createElement('span');
                chip.className = `dv-chip ${cls}${isAssigned ? ' assigned' : ''}`;
                chip.dataset.col = col;
                chip.dataset.kind = kind;
                chip.title = state.columnDefinitions[col] || col;
                chip.innerHTML = `<span class="opacity-60">${icon}</span>${escapeHtml(lbl)}`;
                chip.addEventListener('click', () => handleChipClick(col, kind));
                // ── Drag support ──────────────────────────────────────────
                chip.draggable = true;
                chip.addEventListener('dragstart', function(e) {
                    e.dataTransfer.setData('application/dv-chip', JSON.stringify({ col: col, kind: kind }));
                    e.dataTransfer.effectAllowed = 'copy';
                    chip.classList.add('dragging');
                });
                chip.addEventListener('dragend', function() {
                    chip.classList.remove('dragging');
                });
                return chip;
            }

            // Render DIMENSIONS
            if (dimListEl) {
                dimListEl.innerHTML = '';
                if (dimCols.length === 0 && assessCols.length === 0) {
                    dimListEl.innerHTML = '<span class="text-[11px] text-slate-400 italic px-1">None</span>';
                } else {
                    [...dimCols, ...assessCols].forEach((col) => {
                        const kind = assessCols.includes(col) ? 'assess' : 'dim';
                        dimListEl.appendChild(makeChip(col, kind));
                    });
                }
            }
            if (dimCountEl) dimCountEl.textContent = (dimCols.length + assessCols.length) || '';

            // Render METRICS
            if (metricListEl) {
                metricListEl.innerHTML = '';
                if (metricCols.length === 0) {
                    metricListEl.innerHTML = '<span class="text-[11px] text-slate-400 italic px-1">None</span>';
                } else {
                    metricCols.forEach((col) => metricListEl.appendChild(makeChip(col, 'metric')));
                }
            }
            if (metricCountEl) metricCountEl.textContent = metricCols.length || '';
        }

        // Auto-rebuild panels when state changes (hook onto after-load)
        const _origRenderPreview = typeof renderPreview === 'function' ? renderPreview : null;

        // ─── Chart type → slot configuration ──────────────────────────────
        const CHART_SLOT_CONFIG = {
            bar:          { show:['x','series','y'], xLabel:'Category',       seriesLabel:'Series / Group',      yLabel:'Value',         xKinds:['dim','assess'] },
            grouped_bar:  { show:['x','series','y'], xLabel:'Category',       seriesLabel:'Group Column',        yLabel:'Value',         xKinds:['dim','assess'] },
            stacked_bar:  { show:['x','series','y'], xLabel:'Category',       seriesLabel:'Stack Column',        yLabel:'Value',         xKinds:['dim','assess'] },
            line:         { show:['x','series','y'], xLabel:'X / Category',   seriesLabel:'Series (optional)',   yLabel:'Y Value',       xKinds:['dim','assess'] },
            area:         { show:['x','series','y'], xLabel:'X / Category',   seriesLabel:'Series (optional)',   yLabel:'Y Value',       xKinds:['dim','assess'] },
            stacked_area: { show:['x','series','y'], xLabel:'X / Category',   seriesLabel:'Stack by',            yLabel:'Y Value',       xKinds:['dim','assess'] },
            pie:          { show:['x','y'],          xLabel:'Label / Category',seriesLabel:'',                   yLabel:'Value',         xKinds:['dim','assess'] },
            donut:        { show:['x','y'],          xLabel:'Label / Category',seriesLabel:'',                   yLabel:'Value',         xKinds:['dim','assess'] },
            scatter:      { show:['x','series','y'], xLabel:'X Value',        seriesLabel:'Color / Group',       yLabel:'Y Value',       xKinds:['metric','dim','assess'] },
            bubble:       { show:['x','series','y','size'], xLabel:'X Value', seriesLabel:'Color / Group',       yLabel:'Y Value',       xKinds:['metric','dim','assess'] },
            heatmap:      { show:['x','series','y'], xLabel:'X Axis',         seriesLabel:'Y Axis',              yLabel:'Color / Value', xKinds:['dim','assess'] },
            histogram:    { show:['x','series'],     xLabel:'Column',         seriesLabel:'Group by (optional)', yLabel:'',              xKinds:['metric','dim'] },
            box:          { show:['x','series','y'], xLabel:'Category',       seriesLabel:'Group (optional)',    yLabel:'Value Column',  xKinds:['dim','assess'] },
            funnel:       { show:['x','y'],          xLabel:'Stage / Label',  seriesLabel:'',                   yLabel:'Value',         xKinds:['dim','assess'] },
            treemap:      { show:['x','y'],          xLabel:'Category',       seriesLabel:'',                   yLabel:'Size / Value',  xKinds:['dim','assess'] },
            radar:        { show:['x','series','y'], xLabel:'Category',       seriesLabel:'Series (optional)',   yLabel:'Value',         xKinds:['dim','assess'] },
            gauge:        { show:['y'],              xLabel:'',               seriesLabel:'',                   yLabel:'Value Metric',  xKinds:[] },
        };

        function updateSlotsForChartType(type) {
            const cfg = CHART_SLOT_CONFIG[type] || CHART_SLOT_CONFIG['bar'];
            const xWrap      = document.getElementById('dv-wrap-x');
            const seriesWrap = document.getElementById('dv-wrap-stack');
            const yWrap      = document.getElementById('dv-wrap-y');
            const sizeWrap   = document.getElementById('dv-wrap-size');

            // Show / hide wrappers
            if (xWrap)      xWrap.style.display     = cfg.show.includes('x')      ? '' : 'none';
            if (seriesWrap) seriesWrap.style.display = cfg.show.includes('series') ? '' : 'none';
            if (yWrap)      yWrap.style.display      = cfg.show.includes('y')      ? '' : 'none';
            if (sizeWrap)   sizeWrap.style.display   = cfg.show.includes('size')   ? '' : 'none';

            // Update labels
            const xLabelEl      = xWrap      && xWrap.querySelector('label');
            const seriesLabelEl = seriesWrap && seriesWrap.querySelector('label');
            const yLabelEls     = yWrap      && yWrap.querySelectorAll('label');
            if (xLabelEl && cfg.xLabel)      xLabelEl.textContent = cfg.xLabel;
            if (seriesLabelEl && cfg.seriesLabel !== undefined)
                seriesLabelEl.textContent = cfg.seriesLabel || 'Series / Split by';
            if (yLabelEls && yLabelEls.length && cfg.yLabel) yLabelEls[0].textContent = cfg.yLabel;

            // Update SLOTS x kinds (scatter/bubble allow numeric X)
            if (SLOTS && SLOTS.x) {
                SLOTS.x.kinds = cfg.xKinds && cfg.xKinds.length ? cfg.xKinds : ['dim','assess'];
            }

            // Refresh placeholder text for empty slots
            if (SLOTS) {
                Object.entries(SLOTS).forEach(function([k, s]) {
                    if (!slotState[k] && s.el) {
                        const lbl = k === 'x' ? (cfg.xLabel || 'dimension')
                            : k === 'series' ? (cfg.seriesLabel || 'dimension / metric')
                            : k === 'y' ? (cfg.yLabel || 'metric')
                            : 'metric';
                        s.el.innerHTML = '<span class="dv-slot-placeholder">Drag or click a ' + lbl.toLowerCase() + '</span>';
                    }
                });
            }
        }

        // ─── Slot drop wiring ──────────────────────────────────────────────
        function wireSlotDrop(slotKey) {
            var slotDef = SLOTS[slotKey];
            var el = slotDef && slotDef.el;
            if (!el) return;

            el.addEventListener('dragover', function(e) {
                e.preventDefault();
                e.dataTransfer.dropEffect = 'copy';
                el.classList.add('dragover');
            });
            el.addEventListener('dragleave', function(e) {
                if (!el.contains(e.relatedTarget)) el.classList.remove('dragover');
            });
            el.addEventListener('drop', function(e) {
                e.preventDefault();
                el.classList.remove('dragover');
                try {
                    var data = JSON.parse(e.dataTransfer.getData('application/dv-chip'));
                    var col  = data.col;
                    var kind = data.kind;
                    if (slotDef.kinds.includes(kind)) {
                        assignSlot(slotKey, col);
                    } else {
                        // Visual invalid flash
                        el.classList.add('drop-invalid');
                        setTimeout(function() { el.classList.remove('drop-invalid'); }, 700);
                    }
                } catch(_) {}
            });
        }

        // ─── Slot assignment ───────────────────────────────────────────────

        // Slot meta: { select: HTMLSelect, hidden: bool, kind: 'dim'|'metric' }
        const SLOTS = {
            x:      { el: slotXEl,      selectEl: xColEl,     label: 'X Axis',     kinds: ['dim','assess'] },
            series: { el: slotSeriesEl, selectEl: stackColEl,  label: 'Series',     kinds: ['dim','assess','metric'] },
            y:      { el: slotYEl,      selectEl: yColEl,      label: 'Y Value',    kinds: ['metric','dim','assess'] },
            size:   { el: slotSizeEl,   selectEl: sizeColEl,   label: 'Bubble Size',kinds: ['metric'] },
        };

        function renderSlot(slotKey) {
            const { el, label } = SLOTS[slotKey];
            if (!el) return;
            const col = slotState[slotKey];
            if (col) {
                el.innerHTML = `<span class="dv-slot-badge">
                    ${escapeHtml(colDisplayLabel(col))}
                    <span class="rm-btn" data-slot="${slotKey}" title="Remove">×</span>
                </span>`;
                el.querySelectorAll('.rm-btn').forEach((btn) => {
                    btn.addEventListener('click', (e) => {
                        e.stopPropagation();
                        assignSlot(btn.dataset.slot, '');
                    });
                });
            } else {
                el.innerHTML = `<span class="dv-slot-placeholder">Drop or click a ${label.toLowerCase()}</span>`;
            }
        }

        function assignSlot(slotKey, col) {
            // If col is already assigned to another slot, clear that slot first
            if (col) {
                Object.keys(slotState).forEach((k) => {
                    if (k !== slotKey && slotState[k] === col) {
                        slotState[k] = '';
                        renderSlot(k);
                        syncSelect(k);
                    }
                });
            }
            slotState[slotKey] = col;
            renderSlot(slotKey);
            syncSelect(slotKey);
            buildDimMetricPanels();   // refresh "assigned" styling on chips
        }

        function syncSelect(slotKey) {
            const { selectEl } = SLOTS[slotKey];
            if (!selectEl) return;
            // Ensure the option exists in the hidden select
            const col = slotState[slotKey];
            if (col && !selectEl.querySelector(`option[value="${CSS.escape(col)}"]`)) {
                const opt = document.createElement('option');
                opt.value = col;
                opt.textContent = colDisplayLabel(col);
                selectEl.appendChild(opt);
            }
            selectEl.value = col;
            selectEl.dispatchEvent(new Event('change'));
        }

        // Assign-popover: tiny dropdown that appears when clicking a chip
        let _popover = null;

        function closePopover() {
            if (_popover) { _popover.remove(); _popover = null; }
        }
        document.addEventListener('click', (e) => {
            if (_popover && !_popover.contains(e.target)) closePopover();
        });

        function handleChipClick(col, kind) {
            closePopover();

            // Determine eligible slots for this chip type
            const eligible = Object.entries(SLOTS).filter(([, s]) => s.kinds.includes(kind));

            // Fast-assign if only one slot or an empty slot exists
            const emptySlot = eligible.find(([k]) => !slotState[k]);
            if (emptySlot) {
                assignSlot(emptySlot[0], col);
                return;
            }

            // Show tiny popover
            const chip = (dimListEl || metricListEl).closest('#dv-explore-mode')
                ?.querySelector(`.dv-chip[data-col="${CSS.escape(col)}"]`);
            const anchor = chip || document.activeElement;
            const rect = anchor ? anchor.getBoundingClientRect() : { left: 100, bottom: 100 };

            const pop = document.createElement('div');
            pop.style.cssText = `position:fixed;left:${rect.left}px;top:${rect.bottom + 4}px;
                background:#1e293b;color:#fff;border-radius:8px;padding:4px 0;
                font-size:11px;font-weight:600;z-index:200;box-shadow:0 4px 12px rgba(0,0,0,.3);min-width:160px;`;
            pop.innerHTML = `<div style="padding:4px 12px;opacity:.5;font-size:10px;text-transform:uppercase;letter-spacing:.08em;">Assign "${colDisplayLabel(col)}" to</div>`;
            eligible.forEach(([k, s]) => {
                const current = slotState[k] ? `<span style="opacity:.5;font-size:10px"> (${colDisplayLabel(slotState[k])})</span>` : '';
                const item = document.createElement('div');
                item.style.cssText = 'padding:6px 16px;cursor:pointer;border-radius:4px;';
                item.innerHTML = `→ ${s.label}${current}`;
                item.addEventListener('mouseenter', () => { item.style.background = '#3b82f6'; });
                item.addEventListener('mouseleave', () => { item.style.background = ''; });
                item.addEventListener('click', (e) => {
                    e.stopPropagation();
                    assignSlot(k, col);
                    closePopover();
                });
                pop.appendChild(item);
            });
            document.body.appendChild(pop);
            _popover = pop;
        }

        // ─── Dimension search filter ────────────────────────────────────────
        if (dimSearchEl) {
            dimSearchEl.addEventListener('input', buildDimMetricPanels);
        }

        // ─── Hook onto data load to rebuild dim/metric panels ───────────────
        // Patch the existing loadData function's success callback by listening on
        // the load button's custom loadComplete event or via MutationObserver on
        // previewBody. We use a simple marker: after state.rows is populated.

        const _origLoadBtn = document.getElementById('dv-load-data');
        if (_origLoadBtn) {
            // MutationObserver on the preview table: after rows appear, rebuild
            if (previewBody) {
                const obs = new MutationObserver(() => {
                    if (state.rows && state.rows.length > 0) {
                        buildDimMetricPanels();
                    }
                });
                obs.observe(previewBody, { childList: true });
            }
        }

        // Also rebuild panels whenever existing dropdowns are repopulated (fillSelect calls)
        if (xColEl) {
            xColEl.addEventListener('_panelRefresh', buildDimMetricPanels);
        }

        // Initialise all slot renders + drag/drop wiring
        Object.keys(SLOTS).forEach(renderSlot);
        Object.keys(SLOTS).forEach(wireSlotDrop);

        // ── MULTI-DIMENSIONAL GROUP-BY ────────────────────────────────────
        function renderGroupByChips() {
            if (!groupByChipsEl) return;
            const cols = state.chartGroupByCols || [];
            groupByChipsEl.innerHTML = '';
            if (!cols.length) {
                groupByChipsEl.innerHTML = '<span class="dv-slot-placeholder">Drag dimensions to add group levels</span>';
                if (groupByHintEl) groupByHintEl.classList.add('hidden');
                return;
            }
            cols.forEach(function (col) {
                var lbl = colDisplayLabel ? colDisplayLabel(col) : col;
                var chip = document.createElement('span');
                chip.className = 'dv-slot-badge inline-flex items-center gap-1';
                chip.innerHTML = escapeHtml(lbl)
                    + '<span class="rm-btn cursor-pointer hover:text-red-600 ml-0.5" data-gbcol="'
                    + escapeHtml(col) + '" title="Remove">\xd7</span>';
                chip.querySelector('.rm-btn').addEventListener('click', function () {
                    removeGroupByCol(col);
                });
                groupByChipsEl.appendChild(chip);
            });
            // Show hint
            if (groupByHintEl && groupByPreviewEl) {
                var primaryX = xColEl ? xColEl.value : '';
                var allLevels = [primaryX].concat(cols).filter(Boolean).map(function (c) {
                    return colDisplayLabel ? colDisplayLabel(c) : c;
                });
                groupByPreviewEl.textContent = allLevels.join(' \xb7 ');
                groupByHintEl.classList.remove('hidden');
            }
        }

        function addGroupByCol(col) {
            if (!col) return;
            // Don't duplicate or shadow the primary X slot
            if ((state.chartGroupByCols || []).includes(col)) return;
            // Remove from any existing slot assignment first
            Object.keys(slotState).forEach(function (k) {
                if (slotState[k] === col) {
                    assignSlot(k, '');
                }
            });
            state.chartGroupByCols = (state.chartGroupByCols || []).concat([col]);
            renderGroupByChips();
            buildDimMetricPanels();
            autoRenderChart();
        }

        function removeGroupByCol(col) {
            state.chartGroupByCols = (state.chartGroupByCols || []).filter(function (c) { return c !== col; });
            renderGroupByChips();
            buildDimMetricPanels();
            autoRenderChart();
        }

        function clearGroupByCols() {
            state.chartGroupByCols = [];
            renderGroupByChips();
        }

        // Drag-and-drop: the group-by zone accepts dim/assess chips
        if (groupByChipsEl) {
            groupByChipsEl.addEventListener('dragover', function (e) {
                e.preventDefault();
                e.dataTransfer.dropEffect = 'copy';
                groupByChipsEl.classList.add('dragover');
            });
            groupByChipsEl.addEventListener('dragleave', function (e) {
                if (!groupByChipsEl.contains(e.relatedTarget)) groupByChipsEl.classList.remove('dragover');
            });
            groupByChipsEl.addEventListener('drop', function (e) {
                e.preventDefault();
                groupByChipsEl.classList.remove('dragover');
                try {
                    var data = JSON.parse(e.dataTransfer.getData('application/dv-chip'));
                    if (data.kind === 'dim' || data.kind === 'assess') {
                        addGroupByCol(data.col);
                    } else {
                        groupByChipsEl.classList.add('drop-invalid');
                        setTimeout(function () { groupByChipsEl.classList.remove('drop-invalid'); }, 700);
                    }
                } catch (_) {}
            });
        }

        // Patch handleChipClick to offer "Add as group level" when X is already filled
        var _origHandleChipClick = handleChipClick;
        handleChipClick = function (col, kind) {
            // If this is a dim/assess chip and X is already assigned, offer group-by
            if ((kind === 'dim' || kind === 'assess') && slotState['x'] && slotState['x'] !== col) {
                // Check if all eligible slots for this kind are filled
                var eligible = Object.entries(SLOTS).filter(function (e) { return e[1].kinds.includes(kind); });
                var emptySlot = eligible.find(function (e) { return !slotState[e[0]]; });
                if (!emptySlot) {
                    // All slots full — directly add as group level
                    addGroupByCol(col);
                    return;
                }
                // There's an empty slot, but also show group-by option via custom popover
                // Fall through to original handler which will assign the empty slot,
                // but also add our "group level" option to the popover
                var _origClosePopover = closePopover;
                // Let the original build the popover first
                _origHandleChipClick(col, kind);
                // Then inject the group-level option into the existing popover if shown
                if (_popover) {
                    var groupItem = document.createElement('div');
                    groupItem.style.cssText = 'padding:6px 16px;cursor:pointer;border-radius:4px;border-top:1px solid rgba(255,255,255,.1);margin-top:2px;';
                    var alreadyGrouped = (state.chartGroupByCols || []).includes(col);
                    groupItem.innerHTML = (alreadyGrouped ? '\u2714 ' : '\u2295 ') + 'Add as Group Level';
                    groupItem.addEventListener('mouseenter', function () { groupItem.style.background = '#10b981'; });
                    groupItem.addEventListener('mouseleave', function () { groupItem.style.background = ''; });
                    groupItem.addEventListener('click', function (e) {
                        e.stopPropagation();
                        if (!alreadyGrouped) addGroupByCol(col);
                        closePopover();
                    });
                    _popover.appendChild(groupItem);
                }
                return;
            }
            _origHandleChipClick(col, kind);
        };

        // Update buildDimMetricPanels to style group-by chips as assigned
        var _origBuildDimMetricPanels = buildDimMetricPanels;
        buildDimMetricPanels = function () {
            _origBuildDimMetricPanels();
            // Re-style chips that are in chartGroupByCols
            var gbCols = new Set(state.chartGroupByCols || []);
            if (!gbCols.size) return;
            var allChips = document.querySelectorAll('.dv-chip');
            allChips.forEach(function (chip) {
                if (gbCols.has(chip.dataset.col)) {
                    chip.classList.add('assigned');
                }
            });
        };

        // Initial render of (empty) group-by zone
        renderGroupByChips();
        // ── END MULTI-DIMENSIONAL GROUP-BY ────────────────────────────────

        // ── Chart type change → update slot labels / visibility ───────────────
        const _chartTypeSelectEl = document.getElementById('dv-chart-type');
        if (_chartTypeSelectEl) {
            _chartTypeSelectEl.addEventListener('change', function() {
                updateSlotsForChartType(_chartTypeSelectEl.value);
            });
            // Apply initial state (bar is default)
            updateSlotsForChartType(_chartTypeSelectEl.value || 'bar');
        }

        // ──────────────────────────────────────────────────────────────────
        // ── SQL LAB ────────────────────────────────────────────────────────
        // ──────────────────────────────────────────────────────────────────

        const sqlInputEl     = document.getElementById('dv-sql-input');
        const sqlRunBtn      = document.getElementById('dv-sql-run');
        const sqlStatusEl    = document.getElementById('dv-sql-status');
        const sqlHeadEl      = document.getElementById('dv-sql-head');
        const sqlBodyEl      = document.getElementById('dv-sql-body');
        const sqlRowCountEl  = document.getElementById('dv-sql-row-count');
        const sqlCreateChartBtn = document.getElementById('dv-sql-create-chart');
        const sqlTableListEl = document.getElementById('dv-sql-table-list');

        let sqlResultState = { columns: [], colTypes: {}, rows: [] };

        function loadSqlSchema() {
            if (!schemaUrl || !sqlTableListEl) return;
            fetch(schemaUrl, { credentials: 'same-origin' })
                .then((r) => r.json())
                .then((data) => {
                    if (!data.tables) return;
                    sqlTableListEl.innerHTML = '';
                    data.tables.forEach((t) => {
                        const item = document.createElement('div');
                        const isView = t.type === 'VIEW';
                        item.className = 'px-2 py-1 rounded hover:bg-white cursor-pointer text-xs text-slate-700 flex items-center gap-1.5';
                        item.innerHTML = `<span class="text-[10px] ${isView ? 'text-purple-500' : 'text-blue-500'}">${isView ? '⊕' : '▦'}</span>${escapeHtml(t.name)}`;
                        item.addEventListener('click', () => {
                            if (sqlInputEl) {
                                sqlInputEl.value = `SELECT * FROM ${t.name} LIMIT 100;`;
                                sqlInputEl.focus();
                            }
                        });
                        sqlTableListEl.appendChild(item);
                    });
                })
                .catch(() => {});
        }

        function runSqlQuery() {
            if (!sqlUrl || !sqlInputEl) return;
            const sql = sqlInputEl.value.trim();
            if (!sql) return;
            if (sqlStatusEl) sqlStatusEl.textContent = 'Running…';
            if (sqlRunBtn) sqlRunBtn.disabled = true;
            if (sqlCreateChartBtn) sqlCreateChartBtn.classList.add('hidden');

            fetch(sqlUrl, {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json', 'X-CSRFToken': csrfToken },
                body: JSON.stringify({ sql }),
            })
                .then((r) => r.json())
                .then((data) => {
                    if (sqlRunBtn) sqlRunBtn.disabled = false;
                    if (data.error) {
                        if (sqlStatusEl) sqlStatusEl.textContent = `Error: ${data.error}`;
                        if (sqlHeadEl) sqlHeadEl.innerHTML = '';
                        if (sqlBodyEl) sqlBodyEl.innerHTML = '';
                        if (sqlRowCountEl) sqlRowCountEl.textContent = '';
                        return;
                    }
                    sqlResultState = { columns: data.columns || [], colTypes: data.col_types || {}, rows: data.rows || [] };

                    const cols = data.columns || [];
                    const rows = data.rows || [];

                    if (sqlHeadEl) {
                        sqlHeadEl.innerHTML = '<tr>' + cols.map((c) =>
                            `<th class="px-3 py-1.5 text-left text-[11px] font-bold text-slate-600 whitespace-nowrap border-r border-slate-200 last:border-r-0">${escapeHtml(c)}</th>`
                        ).join('') + '</tr>';
                    }
                    if (sqlBodyEl) {
                        sqlBodyEl.innerHTML = rows.slice(0, 500).map((row) =>
                            '<tr class="hover:bg-slate-50">' + cols.map((c) => {
                                const v = row[c];
                                return `<td class="px-3 py-1 text-[11px] text-slate-700 border-r border-slate-100 last:border-r-0 whitespace-nowrap max-w-[200px] truncate" title="${escapeHtml(String(v ?? ''))}">${escapeHtml(String(v ?? ''))}</td>`;
                            }).join('') + '</tr>'
                        ).join('');
                    }

                    const rowCount = rows.length;
                    const hasMore  = data.has_more;
                    if (sqlStatusEl) sqlStatusEl.textContent = `${rowCount} row${rowCount !== 1 ? 's' : ''} returned${hasMore ? ' (limited)' : ''}`;
                    if (sqlRowCountEl) sqlRowCountEl.textContent = hasMore ? '⚠ Results capped at 2,000 rows.' : '';

                    if (sqlCreateChartBtn && cols.length > 0 && rows.length > 0) {
                        sqlCreateChartBtn.classList.remove('hidden');
                    }
                })
                .catch((err) => {
                    if (sqlRunBtn) sqlRunBtn.disabled = false;
                    if (sqlStatusEl) sqlStatusEl.textContent = `Fetch error: ${err.message}`;
                });
        }

        if (sqlRunBtn) sqlRunBtn.addEventListener('click', runSqlQuery);
        if (sqlInputEl) {
            sqlInputEl.addEventListener('keydown', (e) => {
                if ((e.ctrlKey || e.metaKey) && e.key === 'Enter') { e.preventDefault(); runSqlQuery(); }
            });
        }

        // "Explore in Chart Builder" — load SQL results into Explore mode
        if (sqlCreateChartBtn) {
            sqlCreateChartBtn.addEventListener('click', () => {
                const { columns, colTypes, rows } = sqlResultState;
                if (!rows.length) return;

                // Inject into state
                state.rows    = rows;
                state.columns = columns;
                state.columnTypes = {};
                state.columnDefinitions = {};
                state.filteredRows = [...rows];
                columns.forEach((c) => {
                    state.columnTypes[c] = colTypes[c] || 'string';
                    state.columnDefinitions[c] = c;
                });

                // Re-trigger the post-load repopulation
                const colCount = columns.length;
                const rowCount = rows.length;

                // Repopulate dropdowns (reuse existing util if available)
                const allCols  = columns.map((c) => [c, c]);
                fillSelect && fillSelect(xColEl, allCols, columns[0] || '', false);
                fillSelect && fillSelect(yColEl, allCols, '', false);
                fillSelect && fillSelect(stackColEl, allCols, '', false);
                fillSelect && fillSelect(sizeColEl, allCols, '', false);
                [xColEl, yColEl, stackColEl, sizeColEl].forEach((el) => { if (el) el.disabled = false; });
                aggEl.disabled = false;
                renderBtn.disabled = false;
                chartTypeEl.disabled = false;

                if (datasetSummaryEl) {
                    datasetSummaryEl.textContent = `SQL: ${rowCount.toLocaleString()} rows × ${colCount} cols`;
                    datasetSummaryEl.classList.remove('hidden');
                }

                buildDimMetricPanels();
                state.chartGroupByCols = [];
                renderGroupByChips();
                switchMode('explore');
            });
        }

        // ──────────────────────────────────────────────────────────────────
        // ── SAVE CHART MODAL ───────────────────────────────────────────────
        // ──────────────────────────────────────────────────────────────────

        const saveChartBtn      = document.getElementById('dv-save-chart-btn');
        const saveModalEl        = document.getElementById('dv-save-modal');
        const chartNameEl        = document.getElementById('dv-chart-name');
        const chartDescEl        = document.getElementById('dv-chart-desc');
        const saveErrorEl        = document.getElementById('dv-save-error');
        const saveOverwriteWarnEl= document.getElementById('dv-save-overwrite-warn');
        const saveOverwriteNameEl= document.getElementById('dv-save-overwrite-name');
        const saveCancelBtn      = document.getElementById('dv-save-cancel');
        const saveConfirmBtn     = document.getElementById('dv-save-confirm');

        let _lastSavedChartId = null;
        let _pendingOverwriteId = null;  // set when a name conflict needs confirmation

        function openSaveModal() {
            if (!saveModalEl) return;
            if (saveErrorEl) { saveErrorEl.textContent = ''; saveErrorEl.classList.add('hidden'); }
            if (saveOverwriteWarnEl) saveOverwriteWarnEl.classList.add('hidden');
            _pendingOverwriteId = null;
            if (saveConfirmBtn) saveConfirmBtn.textContent = 'Save';
            // Pre-fill name/desc from last saved chart if we are in update mode
            if (_lastSavedChartId && chartNameEl && !chartNameEl.value) {
                const last = _savedCharts.find((c) => c.id === _lastSavedChartId);
                if (last) {
                    chartNameEl.value = last.name || '';
                    if (chartDescEl) chartDescEl.value = last.description || '';
                }
            }
            saveModalEl.classList.add('open');
        }
        function closeSaveModal() {
            if (saveModalEl) saveModalEl.classList.remove('open');
            _pendingOverwriteId = null;
            if (saveConfirmBtn) saveConfirmBtn.textContent = 'Save';
        }

        // ──────────────────────────────────────────────────────────────────
        // ── MY CHARTS MANAGEMENT ──────────────────────────────────────────
        // ──────────────────────────────────────────────────────────────────

        const myChartsBtnEl        = document.getElementById('dv-my-charts-btn');
        const chartsManageModalEl  = document.getElementById('dv-charts-manage-modal');
        const chartsManageCloseEl  = document.getElementById('dv-charts-manage-close');
        const chartsManageDoneEl   = document.getElementById('dv-charts-manage-done');
        const chartsManageListEl   = document.getElementById('dv-charts-manage-list');

        function openChartManage() {
            if (!chartsManageModalEl) return;
            chartsManageModalEl.classList.add('open');
            refreshChartManageList();
        }

        function closeChartManage() {
            if (chartsManageModalEl) chartsManageModalEl.classList.remove('open');
        }

        function refreshChartManageList() {
            if (!chartsManageListEl || !chartsUrl) return;
            chartsManageListEl.innerHTML = '<p class="text-xs text-slate-400 italic">Loading…</p>';
            fetch(chartsUrl, { credentials: 'same-origin' })
                .then((r) => r.json())
                .then((data) => {
                    _savedCharts = data.charts || [];
                    renderChartManageList();
                    refreshAddToDashSelect();
                })
                .catch(() => {
                    chartsManageListEl.innerHTML = '<p class="text-xs text-red-500">Failed to load charts.</p>';
                });
        }

        function renderChartManageList() {
            if (!chartsManageListEl) return;
            if (!_savedCharts.length) {
                chartsManageListEl.innerHTML = '<p class="text-xs text-slate-400 italic">No saved charts yet. Use the Save Chart button in Explore mode.</p>';
                return;
            }
            chartsManageListEl.innerHTML = '';
            _savedCharts.forEach((chart) => {
                const row = document.createElement('div');
                row.className = 'flex items-center gap-2 px-3 py-2 rounded-lg border border-slate-100 hover:bg-slate-50';
                row.dataset.chartId = chart.id;

                const typeColors = {
                    bar:'bg-blue-100 text-blue-700', line:'bg-cyan-100 text-cyan-700',
                    pie:'bg-purple-100 text-purple-700', area:'bg-indigo-100 text-indigo-700',
                    scatter:'bg-orange-100 text-orange-700',
                };
                const typeBadge = typeColors[chart.chart_type] || 'bg-slate-100 text-slate-600';
                const dateStr   = chart.created_at ? chart.created_at.split('T')[0] : '';

                row.innerHTML = `
                    <div class="flex-1 min-w-0">
                        <div class="cm-chart-name text-sm font-semibold text-slate-800 truncate">${escapeHtml(chart.name)}</div>
                        <div class="cm-chart-rename hidden mt-1">
                            <input type="text" class="cm-rename-input w-full px-2 py-1 text-xs border border-blue-400 rounded-lg" value="${escapeHtml(chart.name)}">
                        </div>
                        <div class="text-[10px] text-slate-400 mt-0.5">${dateStr}</div>
                    </div>
                    <span class="shrink-0 px-1.5 py-0.5 rounded text-[10px] font-bold uppercase ${typeBadge}">${escapeHtml(chart.chart_type || '—')}</span>
                    <div class="flex gap-1 shrink-0">
                        <button type="button" class="cm-load px-2 py-1 text-[11px] font-semibold text-white bg-blue-600 rounded hover:bg-blue-500" title="Load into Explore">&#9654; Load</button>
                        <button type="button" class="cm-rename px-2 py-1 text-[11px] font-semibold border border-slate-300 rounded hover:bg-slate-100" title="Rename">&#9998;</button>
                        <button type="button" class="cm-rename-save hidden px-2 py-1 text-[11px] font-semibold bg-emerald-600 text-white rounded hover:bg-emerald-500" title="Save name">&#10003;</button>
                        <button type="button" class="cm-rename-cancel hidden px-2 py-1 text-[11px] font-semibold border border-slate-300 rounded hover:bg-slate-100" title="Cancel">&times;</button>
                        <button type="button" class="cm-delete px-2 py-1 text-[11px] font-semibold border border-red-200 text-red-500 rounded hover:bg-red-50" title="Delete">&#128465;</button>
                    </div>
                `;

                // Load
                row.querySelector('.cm-load').addEventListener('click', () => {
                    loadChartIntoExplore(chart);
                    closeChartManage();
                });

                // Rename toggle
                const nameEl     = row.querySelector('.cm-chart-name');
                const renameWrap = row.querySelector('.cm-chart-rename');
                const renameInput= row.querySelector('.cm-rename-input');
                const renameBtn  = row.querySelector('.cm-rename');
                const saveRenBtn = row.querySelector('.cm-rename-save');
                const canRenBtn  = row.querySelector('.cm-rename-cancel');

                renameBtn.addEventListener('click', () => {
                    nameEl.classList.add('hidden');
                    renameWrap.classList.remove('hidden');
                    renameBtn.classList.add('hidden');
                    saveRenBtn.classList.remove('hidden');
                    canRenBtn.classList.remove('hidden');
                    renameInput.focus();
                });

                canRenBtn.addEventListener('click', () => {
                    nameEl.classList.remove('hidden');
                    renameWrap.classList.add('hidden');
                    renameBtn.classList.remove('hidden');
                    saveRenBtn.classList.add('hidden');
                    canRenBtn.classList.add('hidden');
                });

                saveRenBtn.addEventListener('click', () => {
                    const newName = renameInput.value.trim();
                    if (!newName) return;
                    fetch(saveChartUrl, {
                        method: 'POST', credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json', 'X-CSRFToken': csrfToken },
                        body: JSON.stringify({ id: chart.id, name: newName, chart_type: chart.chart_type, config: chart.config }),
                    })
                        .then((r) => r.json())
                        .then((data) => {
                            if (data.error) { alert('Rename failed: ' + data.error); return; }
                            chart.name = newName;
                            nameEl.textContent = newName;
                            // Toggle back
                            nameEl.classList.remove('hidden');
                            renameWrap.classList.add('hidden');
                            renameBtn.classList.remove('hidden');
                            saveRenBtn.classList.add('hidden');
                            canRenBtn.classList.add('hidden');
                            refreshAddToDashSelect();
                            // Update in _savedCharts array
                            const idx = _savedCharts.findIndex((c) => c.id === chart.id);
                            if (idx >= 0) _savedCharts[idx].name = newName;
                        })
                        .catch(() => alert('Network error.'));
                });

                // Delete
                row.querySelector('.cm-delete').addEventListener('click', () => {
                    if (!confirm(`Delete chart "${chart.name}"? This action cannot be undone.`)) return;
                    fetch(`${chartsUrl}${chart.id}/`, {
                        method: 'DELETE', credentials: 'same-origin',
                        headers: { 'X-CSRFToken': csrfToken },
                    })
                        .then((r) => r.json())
                        .then((data) => {
                            if (data.error) { alert('Delete failed: ' + data.error); return; }
                            row.remove();
                            _savedCharts = _savedCharts.filter((c) => c.id !== chart.id);
                            if (_lastSavedChartId === chart.id) _lastSavedChartId = null;
                            refreshAddToDashSelect();
                            if (!_savedCharts.length) {
                                chartsManageListEl.innerHTML = '<p class="text-xs text-slate-400 italic">No saved charts yet.</p>';
                            }
                        })
                        .catch(() => alert('Network error.'));
                });

                chartsManageListEl.appendChild(row);
            });
        }

        function loadChartIntoExplore(chart) {
            // Switch to Explore mode
            document.getElementById('dv-mode-explore') && document.getElementById('dv-mode-explore').click();

            const cfg = chart.config || {};

            // Restore chart type
            if (chartTypeEl) { chartTypeEl.value = cfg.chart_type || chart.chart_type || 'bar'; chartTypeEl.dispatchEvent(new Event('change')); }

            // Restore aggregation
            if (aggEl && cfg.agg) aggEl.value = cfg.agg;

            // Restore slot columns via assignSlot (preferred) or direct hidden-select fallback
            const slotX      = cfg.slot_x      || cfg.x_col      || '';
            const slotY      = cfg.slot_y      || cfg.y_col      || '';
            const slotSeries = cfg.slot_series || cfg.stack_col  || '';
            const slotSize   = cfg.slot_size   || cfg.size_col   || '';

            if (typeof assignSlot === 'function') {
                if (slotX)      assignSlot('x',      slotX);
                if (slotY)      assignSlot('y',      slotY);
                if (slotSeries) assignSlot('series', slotSeries);
                if (slotSize)   assignSlot('size',   slotSize);
            } else {
                if (xColEl     && slotX)      { xColEl.value     = slotX;      xColEl.dispatchEvent(new Event('change')); }
                if (yColEl     && slotY)      { yColEl.value     = slotY;      yColEl.dispatchEvent(new Event('change')); }
                if (stackColEl && slotSeries) { stackColEl.value = slotSeries; stackColEl.dispatchEvent(new Event('change')); }
                if (sizeColEl  && slotSize)   { sizeColEl.value  = slotSize;   sizeColEl.dispatchEvent(new Event('change')); }
            }

            // Restore multi-dimensional group-by
            const savedGroupBy = cfg.group_by_cols || [];
            state.chartGroupByCols = savedGroupBy.slice();
            if (typeof renderGroupByChips === 'function') renderGroupByChips();

            // Restore inline filters
            if (cfg.inline_filters && Array.isArray(cfg.inline_filters)) {
                _inlineFilters = cfg.inline_filters.slice();
                if (typeof renderFilterChips === 'function') renderFilterChips();
            }

            // Restore dataset filters
            const filters = chart.source_filters || {};
            const searchEl = document.getElementById('dv-search');
            const yearEl   = document.getElementById('dv-school-year');
            const gradeEl  = document.getElementById('dv-grade');
            const statusEl = document.getElementById('dv-status');
            if (searchEl && filters.search) searchEl.value = filters.search;
            if (yearEl   && filters.year)   yearEl.value   = filters.year;
            if (gradeEl  && filters.grade)  gradeEl.value  = filters.grade;
            if (statusEl && filters.status) statusEl.value = filters.status;

            // Update saved chart reference so Save = update
            _lastSavedChartId = chart.id;
            const chartNameEl2 = document.getElementById('dv-chart-name');
            const chartDescEl2 = document.getElementById('dv-chart-desc');
            if (chartNameEl2) chartNameEl2.value = chart.name || '';
            if (chartDescEl2) chartDescEl2.value = chart.description || '';
        }

        if (myChartsBtnEl)       myChartsBtnEl.addEventListener('click', openChartManage);
        if (chartsManageCloseEl) chartsManageCloseEl.addEventListener('click', closeChartManage);
        if (chartsManageDoneEl)  chartsManageDoneEl.addEventListener('click', closeChartManage);

        // Alias for the "Open Appearance options" button in Customize tab
        const openAppDrawerCustBtn = document.getElementById('dv-open-appearance-drawer-customize');
        if (openAppDrawerCustBtn) {
            openAppDrawerCustBtn.addEventListener('click', () => {
                const drawerEl = document.getElementById('dv-drawer-appearance');
                const backdropEl = document.getElementById('dv-drawer-backdrop');
                if (drawerEl) drawerEl.classList.add('open');
                if (backdropEl) backdropEl.classList.add('open');
            });
        }

        if (saveCancelBtn) saveCancelBtn.addEventListener('click', closeSaveModal);
        if (saveChartBtn)  saveChartBtn.addEventListener('click', openSaveModal);

        // Clear overwrite warning when user edits the name
        if (chartNameEl) {
            chartNameEl.addEventListener('input', () => {
                if (_pendingOverwriteId) {
                    _pendingOverwriteId = null;
                    if (saveOverwriteWarnEl) saveOverwriteWarnEl.classList.add('hidden');
                    if (saveConfirmBtn) saveConfirmBtn.textContent = 'Save';
                }
            });
        }

        if (saveConfirmBtn) {
            saveConfirmBtn.addEventListener('click', () => {
                const name = chartNameEl ? chartNameEl.value.trim() : '';
                if (!name) {
                    if (saveErrorEl) { saveErrorEl.textContent = 'Name is required.'; saveErrorEl.classList.remove('hidden'); }
                    return;
                }

                // ── Overwrite-by-name: check if another chart already has this name ────
                const existingByName = _savedCharts.find(
                    (c) => c.name.trim().toLowerCase() === name.toLowerCase()
                        && c.id !== (_lastSavedChartId || 0)
                );
                if (existingByName && !_pendingOverwriteId) {
                    // First click with duplicate name → show warning and wait for re-confirm
                    _pendingOverwriteId = existingByName.id;
                    if (saveOverwriteWarnEl && saveOverwriteNameEl) {
                        saveOverwriteNameEl.textContent = `"${existingByName.name}"`;
                        saveOverwriteWarnEl.classList.remove('hidden');
                    }
                    if (saveConfirmBtn) saveConfirmBtn.textContent = 'Overwrite';
                    return;
                }

                // If pending overwrite, use that chart's ID
                const saveId = _pendingOverwriteId || _lastSavedChartId || null;

                // ── Build full chart config payload ──────────────────────────────────
                // Slot assignments (primary source of truth for x/y/series/size)
                const slotX      = (typeof slotState !== 'undefined' && slotState.x)      || (xColEl     ? xColEl.value     : '');
                const slotY      = (typeof slotState !== 'undefined' && slotState.y)      || (yColEl     ? yColEl.value     : '');
                const slotSeries = (typeof slotState !== 'undefined' && slotState.series) || (stackColEl ? stackColEl.value : '');
                const slotSize   = (typeof slotState !== 'undefined' && slotState.size)   || (sizeColEl  ? sizeColEl.value  : '');

                // Multi-dimensional x_cols: primary X + group-level extras
                const groupByCols = state.chartGroupByCols || [];
                const xCols = slotX
                    ? [slotX, ...groupByCols].filter(Boolean)
                    : groupByCols.filter(Boolean);

                const payload = {
                    id:   saveId,
                    name,
                    description: chartDescEl ? chartDescEl.value.trim() : '',
                    chart_type:  chartTypeEl ? chartTypeEl.value : 'bar',
                    config: {
                        chart_type:     chartTypeEl ? chartTypeEl.value : 'bar',
                        x_col:          slotX,
                        y_col:          slotY,
                        stack_col:      slotSeries,
                        size_col:       slotSize,
                        agg:            aggEl ? aggEl.value : 'count',
                        x_cols:         xCols,
                        group_by_cols:  groupByCols,
                        slot_x:         slotX,
                        slot_series:    slotSeries,
                        slot_y:         slotY,
                        slot_size:      slotSize,
                        inline_filters: _inlineFilters || [],
                        ...Object.fromEntries(
                            Object.entries(styleState).map(([k, v]) => [
                                k.replace(/([A-Z])/g, '_$1').toLowerCase(), v
                            ])
                        ),
                    },
                    source_type:    'query',
                    source_id:      (document.getElementById('dv-saved-query') || {}).value || null,
                    source_filters: {
                        search: (document.getElementById('dv-search')      || {}).value || '',
                        year:   (document.getElementById('dv-school-year') || {}).value || '',
                        grade:  (document.getElementById('dv-grade')       || {}).value || '',
                        status: (document.getElementById('dv-status')      || {}).value || '',
                    },
                    column_defs: state.columnDefinitions || {},
                };

                if (saveConfirmBtn) saveConfirmBtn.disabled = true;

                fetch(saveChartUrl, {
                    method: 'POST',
                    credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'X-CSRFToken': csrfToken },
                    body: JSON.stringify(payload),
                })
                    .then((r) => r.json())
                    .then((data) => {
                        if (saveConfirmBtn) saveConfirmBtn.disabled = false;
                        if (data.error) {
                            if (saveErrorEl) { saveErrorEl.textContent = data.error; saveErrorEl.classList.remove('hidden'); }
                            return;
                        }
                        _lastSavedChartId = data.chart && data.chart.id;
                        _pendingOverwriteId = null;
                        _savedCharts = [data.chart, ..._savedCharts.filter((c) => c.id !== data.chart.id)];
                        closeSaveModal();
                        refreshAddToDashSelect();
                    })
                    .catch((err) => {
                        if (saveConfirmBtn) saveConfirmBtn.disabled = false;
                        if (saveErrorEl) { saveErrorEl.textContent = err.message; saveErrorEl.classList.remove('hidden'); }
                    });
            });
        }

        // ──────────────────────────────────────────────────────────────────
        // ── DASHBOARD ─────────────────────────────────────────────────────
        // ──────────────────────────────────────────────────────────────────

        let _dashboards = [];
        let _savedCharts = [];
        let _activeDashboard = null;

        const dashSelectEl     = document.getElementById('dv-dashboard-select');
        const dashNewBtn       = document.getElementById('dv-dashboard-new');
        const dashAddChartBtn  = document.getElementById('dv-dashboard-add-chart');
        const dashRunAllBtn    = document.getElementById('dv-dashboard-run-all');
        const dashStatusEl     = document.getElementById('dv-dashboard-status');
        const dashGridEl       = document.getElementById('dv-dash-grid');

        const addToDashModal   = document.getElementById('dv-add-to-dash-modal');
        const addDashSelectEl  = document.getElementById('dv-add-dash-select');
        const addDashWidthEl   = document.getElementById('dv-add-dash-width');
        const addDashErrorEl   = document.getElementById('dv-add-dash-error');
        const addDashCancelBtn = document.getElementById('dv-add-dash-cancel');
        const addDashConfirmBtn= document.getElementById('dv-add-dash-confirm');

        function refreshAddToDashSelect() {
            if (!addDashSelectEl) return;
            addDashSelectEl.innerHTML = '<option value="">— select —</option>';
            _dashboards.forEach((d) => {
                const opt = document.createElement('option');
                opt.value = d.id;
                opt.textContent = d.name;
                addDashSelectEl.appendChild(opt);
            });
        }

        function loadDashboards() {
            if (!dashboardsUrl) return;
            Promise.all([
                fetch(dashboardsUrl,         { credentials: 'same-origin' }).then((r) => r.json()),
                chartsUrl ? fetch(chartsUrl, { credentials: 'same-origin' }).then((r) => r.json()) : Promise.resolve({ charts: [] }),
            ])
                .then(([dashData, chartsData]) => {
                    _dashboards  = dashData.dashboards || [];
                    _savedCharts = chartsData.charts || [];

                    if (dashSelectEl) {
                        dashSelectEl.innerHTML = '<option value="">— select or create —</option>';
                        _dashboards.forEach((d) => {
                            const opt = document.createElement('option');
                            opt.value = d.id;
                            opt.textContent = d.name;
                            dashSelectEl.appendChild(opt);
                        });
                    }
                    refreshAddToDashSelect();

                    if (_dashboards.length > 0) {
                        selectDashboard(_dashboards[0].id);
                    }
                })
                .catch(() => {});
        }

        function selectDashboard(id) {
            _activeDashboard = _dashboards.find((d) => d.id === id) || null;
            if (dashSelectEl) dashSelectEl.value = id || '';
            const hasActive = !!_activeDashboard;
            if (dashAddChartBtn) dashAddChartBtn.classList.toggle('hidden', !hasActive);
            if (dashRunAllBtn)   dashRunAllBtn.classList.toggle('hidden', !hasActive);
            // Management buttons (elements may not yet exist; use getElementById for late-binding)
            const _renBtn = document.getElementById('dv-dashboard-rename');
            const _delBtn = document.getElementById('dv-dashboard-delete');
            if (_renBtn) _renBtn.classList.toggle('hidden', !hasActive);
            if (_delBtn) _delBtn.classList.toggle('hidden', !hasActive);
            renderDashGrid();
        }

        function renderDashGrid() {
            if (!dashGridEl) return;
            if (!_activeDashboard) {
                dashGridEl.innerHTML = '<div class="w-full text-center py-16 text-slate-400"><p class="text-lg mb-2">&#9638;</p><p class="text-sm font-semibold">No dashboard selected</p><p class="text-xs mt-1">Create one below or select from the dropdown.</p></div>';
                return;
            }
            const slots = _activeDashboard.charts || [];
            if (slots.length === 0) {
                dashGridEl.innerHTML = '<div class="w-full text-center py-16 text-slate-400"><p class="text-sm font-semibold">No charts yet</p><p class="text-xs mt-1">Save a chart in Explore, then click + Add Chart.</p></div>';
                return;
            }
            dashGridEl.innerHTML = '';
            slots.forEach((slot) => {
                const chart = slot.chart;
                const card  = document.createElement('div');
                card.className = `dv-dash-card width-${slot.width_class}`;
                card.dataset.slotId  = slot.slot_id;
                card.dataset.chartId = chart.id;
                card.innerHTML = `
                    <div class="dv-dash-card-header">
                        <span class="truncate" title="${escapeHtml(chart.name)}">${escapeHtml(chart.name)}</span>
                        <div class="flex items-center gap-1.5 shrink-0 ml-2">
                            <select class="dash-card-width text-[10px] border border-slate-200 rounded px-1 py-0.5 bg-white" data-slot="${slot.slot_id}">
                                <option value="half"  ${slot.width_class==='half'  ?'selected':''}>½</option>
                                <option value="full"  ${slot.width_class==='full'  ?'selected':''}>Full</option>
                                <option value="third" ${slot.width_class==='third' ?'selected':''}>⅓</option>
                            </select>
                            <button class="dash-card-remove text-slate-400 hover:text-red-500 text-sm leading-none" data-slot="${slot.slot_id}" title="Remove">✕</button>
                        </div>
                    </div>
                    <div class="dv-dash-card-body" id="dash-chart-${slot.slot_id}"></div>
                `;
                dashGridEl.appendChild(card);

                // Width change
                card.querySelector('.dash-card-width').addEventListener('change', function() {
                    const slotId = this.dataset.slot;
                    const newWidth = this.value;
                    card.className = `dv-dash-card width-${newWidth}`;
                    fetch(`${dashboardsUrl.replace('api/dashboards/', 'api/slots/')}${slotId}/`, {
                        method: 'POST', credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json', 'X-CSRFToken': csrfToken },
                        body: JSON.stringify({ width_class: newWidth }),
                    }).catch(() => {});
                });

                // Remove
                card.querySelector('.dash-card-remove').addEventListener('click', function() {
                    const slotId = this.dataset.slot;
                    fetch(`${dashboardsUrl.replace('api/dashboards/', 'api/slots/')}${slotId}/`, {
                        method: 'DELETE', credentials: 'same-origin',
                        headers: { 'X-CSRFToken': csrfToken },
                    }).then((r) => r.json()).then(() => {
                        if (_activeDashboard) {
                            _activeDashboard.charts = (_activeDashboard.charts || []).filter((s) => s.slot_id !== parseInt(slotId));
                        }
                        card.remove();
                    }).catch(() => {});
                });
            });

            // Auto-render mini charts
            requestAnimationFrame(() => renderDashboardCharts(slots));
        }

        function renderDashboardCharts(slots) {
            slots.forEach((slot) => {
                const containerEl = document.getElementById(`dash-chart-${slot.slot_id}`);
                if (!containerEl) return;
                const chart = slot.chart;
                const cfg   = chart.config || {};
                const rows  = [];   // Charts on dashboard render empty if no live data; fetch on demand.

                // Attempt to re-load data and render
                loadAndRenderDashCard(containerEl, chart);
            });
        }

        function loadAndRenderDashCard(containerEl, chart) {
            if (!window.DVChartRenderer) return;
            const cfg     = chart.config || {};
            const filters = chart.source_filters || {};
            const colDefs = chart.column_defs || {};

            // Show placeholder
            containerEl.style.display = 'flex';
            containerEl.style.alignItems = 'center';
            containerEl.style.justifyContent = 'center';
            containerEl.innerHTML = '<span style="font-size:11px;color:#94a3b8">Loading…</span>';

            const loadUrl = (appDataEl && appDataEl.dataset.loadStudentsUrl) || '';
            if (!loadUrl) {
                containerEl.innerHTML = '<span style="font-size:11px;color:#94a3b8">Preview unavailable</span>';
                return;
            }

            const params = new URLSearchParams({
                query_id:    (chart.source_id  || ''),
                search:      (filters.search   || ''),
                school_year: (filters.year     || ''),
                grade:       (filters.grade    || ''),
                status:      (filters.status   || 'Active'),
            });

            fetch(`${loadUrl}?${params}`, { credentials: 'same-origin' })
                .then((r) => r.json())
                .then((data) => {
                    const rows = data.rows || data.students || [];
                    if (!rows.length) {
                        containerEl.innerHTML = '<span style="font-size:11px;color:#94a3b8">No data</span>';
                        return;
                    }
                    // Render chart via render API
                    return fetch((appDataEl && appDataEl.dataset.renderChartUrl) || '', {
                        method: 'POST', credentials: 'same-origin',
                        headers: { 'Content-Type': 'application/json', 'X-CSRFToken': csrfToken },
                        body: JSON.stringify({ rows, column_definitions: colDefs, chart_config: cfg }),
                    });
                })
                .then((r) => r ? r.json() : null)
                .then((data) => {
                    if (!data || !data.option) return;
                    containerEl.style.cssText = '';
                    containerEl.innerHTML = '';
                    const renderer = window.DVChartRenderer.create(containerEl);
                    renderer.render(data.option, cfg);
                })
                .catch(() => {
                    containerEl.innerHTML = '<span style="font-size:11px;color:#ef4444">Error</span>';
                });
        }

        // Dashboard run all
        if (dashRunAllBtn) {
            dashRunAllBtn.addEventListener('click', () => {
                if (!_activeDashboard) return;
                renderDashboardCharts(_activeDashboard.charts || []);
            });
        }

        // Dashboard selector
        if (dashSelectEl) {
            dashSelectEl.addEventListener('change', function() {
                const id = parseInt(this.value);
                if (id) selectDashboard(id);
            });
        }

        // New dashboard
        if (dashNewBtn) {
            dashNewBtn.addEventListener('click', () => {
                const name = prompt('New dashboard name:');
                if (!name || !name.trim()) return;
                fetch(dashboardsUrl, {
                    method: 'POST', credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'X-CSRFToken': csrfToken },
                    body: JSON.stringify({ name: name.trim() }),
                })
                    .then((r) => r.json())
                    .then((data) => {
                        if (!data.dashboard) return;
                        data.dashboard.charts = [];
                        _dashboards.unshift(data.dashboard);
                        const opt = document.createElement('option');
                        opt.value = data.dashboard.id;
                        opt.textContent = data.dashboard.name;
                        if (dashSelectEl) { dashSelectEl.insertBefore(opt, dashSelectEl.children[1]); }
                        selectDashboard(data.dashboard.id);
                    })
                    .catch(() => {});
            });
        }

        // Rename dashboard
        const dashRenameBtn = document.getElementById('dv-dashboard-rename');
        const dashDeleteBtn = document.getElementById('dv-dashboard-delete');

        if (dashRenameBtn) {
            dashRenameBtn.addEventListener('click', () => {
                if (!_activeDashboard) return;
                const newName = prompt('Rename dashboard:', _activeDashboard.name);
                if (!newName || !newName.trim() || newName.trim() === _activeDashboard.name) return;
                fetch(`${dashboardsUrl}${_activeDashboard.id}/`, {
                    method: 'PUT', credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'X-CSRFToken': csrfToken },
                    body: JSON.stringify({ name: newName.trim() }),
                })
                    .then((r) => r.json())
                    .then((data) => {
                        if (data.error) { alert('Rename failed: ' + data.error); return; }
                        _activeDashboard.name = newName.trim();
                        // Update dropdown option text
                        if (dashSelectEl) {
                            const opt = dashSelectEl.querySelector(`option[value="${_activeDashboard.id}"]`);
                            if (opt) opt.textContent = newName.trim();
                        }
                        if (dashStatusEl) { dashStatusEl.textContent = `Renamed to "${newName.trim()}"`;  setTimeout(() => { if (dashStatusEl) dashStatusEl.textContent = ''; }, 3000); }
                    })
                    .catch(() => alert('Network error.'));
            });
        }

        if (dashDeleteBtn) {
            dashDeleteBtn.addEventListener('click', () => {
                if (!_activeDashboard) return;
                if (!confirm(`Delete dashboard "${_activeDashboard.name}"? This cannot be undone.`)) return;
                fetch(`${dashboardsUrl}${_activeDashboard.id}/`, {
                    method: 'DELETE', credentials: 'same-origin',
                    headers: { 'X-CSRFToken': csrfToken },
                })
                    .then((r) => r.json())
                    .then((data) => {
                        if (data.error) { alert('Delete failed: ' + data.error); return; }
                        const deletedId = _activeDashboard.id;
                        _dashboards = _dashboards.filter((d) => d.id !== deletedId);
                        // Remove from dropdown
                        if (dashSelectEl) {
                            const opt = dashSelectEl.querySelector(`option[value="${deletedId}"]`);
                            if (opt) opt.remove();
                        }
                        _activeDashboard = null;
                        selectDashboard(_dashboards.length ? _dashboards[0].id : null);
                    })
                    .catch(() => alert('Network error.'));
            });
        }

        // Add chart to dashboard button (opens modal)
        function openAddChartToDashModal() {
            if (!addToDashModal || !_activeDashboard) return;

            const _doOpen = () => {
                const noChartsEl = document.getElementById('dv-add-dash-no-charts');

                if (addDashSelectEl) {
                    addDashSelectEl.innerHTML = '<option value="">\u2014 select saved chart \u2014</option>';
                    _savedCharts.forEach((c) => {
                        const opt = document.createElement('option');
                        opt.value = c.id;
                        opt.textContent = c.name;
                        addDashSelectEl.appendChild(opt);
                    });
                }

                const hasSavedCharts = _savedCharts.length > 0;
                if (noChartsEl) noChartsEl.classList.toggle('hidden', hasSavedCharts);
                if (addDashSelectEl) addDashSelectEl.disabled = !hasSavedCharts;

                const titleEl = document.getElementById('dv-add-to-dash-title');
                if (titleEl) titleEl.textContent = 'Add Chart to \u201c' + _activeDashboard.name + '\u201d';

                if (addDashErrorEl) addDashErrorEl.classList.add('hidden');
                addToDashModal.classList.add('open');
            };

            // If charts haven't been fetched yet, fetch first
            if (!_savedCharts.length && chartsUrl) {
                fetch(chartsUrl, { credentials: 'same-origin' })
                    .then((r) => r.json())
                    .then((data) => {
                        _savedCharts = data.charts || [];
                        _doOpen();
                    })
                    .catch(() => _doOpen());
            } else {
                _doOpen();
            }
        }

        if (dashAddChartBtn) {
            dashAddChartBtn.addEventListener('click', openAddChartToDashModal);
        }

        if (addDashCancelBtn) addDashCancelBtn.addEventListener('click', () => {
            if (addToDashModal) addToDashModal.classList.remove('open');
        });

        if (addDashConfirmBtn) {
            addDashConfirmBtn.addEventListener('click', () => {
                if (!_activeDashboard) {
                    if (addDashErrorEl) { addDashErrorEl.textContent = 'No dashboard selected.'; addDashErrorEl.classList.remove('hidden'); }
                    return;
                }
                const chartId = addDashSelectEl ? parseInt(addDashSelectEl.value) : null;
                const width   = addDashWidthEl  ? addDashWidthEl.value : 'half';
                if (!chartId || isNaN(chartId)) {
                    if (addDashErrorEl) { addDashErrorEl.textContent = 'Select a chart.'; addDashErrorEl.classList.remove('hidden'); }
                    return;
                }
                if (addDashErrorEl) addDashErrorEl.classList.add('hidden');
                if (addDashConfirmBtn) addDashConfirmBtn.disabled = true;

                fetch(`${dashboardsUrl}${_activeDashboard.id}/charts/`, {
                    method: 'POST', credentials: 'same-origin',
                    headers: { 'Content-Type': 'application/json', 'X-CSRFToken': csrfToken },
                    body: JSON.stringify({ action: 'add', chart_id: chartId, width_class: width }),
                })
                    .then((r) => r.json())
                    .then((data) => {
                        if (addDashConfirmBtn) addDashConfirmBtn.disabled = false;
                        if (data.error) {
                            if (addDashErrorEl) { addDashErrorEl.textContent = data.error; addDashErrorEl.classList.remove('hidden'); }
                            return;
                        }
                        if (!data.slot) {
                            if (addDashErrorEl) { addDashErrorEl.textContent = 'Unexpected server response.'; addDashErrorEl.classList.remove('hidden'); }
                            return;
                        }
                        if (!_activeDashboard.charts) _activeDashboard.charts = [];
                        _activeDashboard.charts.push(data.slot);
                        if (addToDashModal) addToDashModal.classList.remove('open');
                        renderDashGrid();
                    })
                    .catch((err) => {
                        if (addDashConfirmBtn) addDashConfirmBtn.disabled = false;
                        if (addDashErrorEl) { addDashErrorEl.textContent = 'Network error: ' + err.message; addDashErrorEl.classList.remove('hidden'); }
                    });
            });
        }

        // ──────────────────────────────────────────────────────────────────
        // ── Right-click / "Add to Dashboard" on saved charts ──────────────
        // ──────────────────────────────────────────────────────────────────
        // Allow the Save button dropdown to also trigger "Add to dashboard"
        // We'll add a context menu on the save button

        const saveChartBtnParent = saveChartBtn && saveChartBtn.parentNode;

        // ──────────────────────────────────────────────────────────────────
        // ── Filter builder in data controls ───────────────────────────────
        // ──────────────────────────────────────────────────────────────────

        const filterChipsEl  = document.getElementById('dv-filter-chips');
        const addFilterBtn   = document.getElementById('dv-add-filter-btn');
        const filterBuilderEl= document.getElementById('dv-filter-builder');
        const filterColSelEl = document.getElementById('dv-filter-col');
        const filterOpEl     = document.getElementById('dv-filter-op');
        const filterValEl    = document.getElementById('dv-filter-val');
        const filterApplyBtn = document.getElementById('dv-filter-apply');
        const filterCancelInlineBtn = document.getElementById('dv-filter-cancel');

        let _inlineFilters = [];  // [{col, op, val}]

        function renderFilterChips() {
            if (!filterChipsEl) return;
            filterChipsEl.innerHTML = '';
            _inlineFilters.forEach((f, idx) => {
                const chip = document.createElement('span');
                chip.className = 'inline-flex items-center gap-1 px-2 py-0.5 bg-blue-100 text-blue-800 rounded-full text-[11px] font-semibold';
                chip.innerHTML = `${escapeHtml(colDisplayLabel(f.col))} ${f.op} ${escapeHtml(f.val)} <span class="cursor-pointer hover:text-red-600 ml-0.5" data-fidx="${idx}">×</span>`;
                chip.querySelector('[data-fidx]').addEventListener('click', () => {
                    _inlineFilters.splice(idx, 1);
                    renderFilterChips();
                });
                filterChipsEl.appendChild(chip);
            });
        }

        function populateFilterColSelect() {
            if (!filterColSelEl) return;
            filterColSelEl.innerHTML = '<option value="">— select column —</option>';
            (state.columns || []).forEach((col) => {
                const opt = document.createElement('option');
                opt.value = col;
                opt.textContent = colDisplayLabel(col);
                filterColSelEl.appendChild(opt);
            });
        }

        if (addFilterBtn) {
            addFilterBtn.addEventListener('click', () => {
                populateFilterColSelect();
                if (filterBuilderEl) filterBuilderEl.classList.remove('hidden');
                if (addFilterBtn) addFilterBtn.classList.add('hidden');
            });
        }

        if (filterCancelInlineBtn) {
            filterCancelInlineBtn.addEventListener('click', () => {
                if (filterBuilderEl) filterBuilderEl.classList.add('hidden');
                if (addFilterBtn) addFilterBtn.classList.remove('hidden');
            });
        }

        if (filterApplyBtn) {
            filterApplyBtn.addEventListener('click', () => {
                const col = filterColSelEl ? filterColSelEl.value : '';
                const op  = filterOpEl ? filterOpEl.value : 'eq';
                const val = filterValEl ? filterValEl.value.trim() : '';
                if (!col || !val) return;
                _inlineFilters.push({ col, op, val });
                renderFilterChips();
                if (filterBuilderEl) filterBuilderEl.classList.add('hidden');
                if (addFilterBtn) addFilterBtn.classList.remove('hidden');
                if (filterValEl) filterValEl.value = '';
            });
        }

        // ── Rebuild dim/metric panels when existing dropdowns are updated ──
        // Hook onto the fillSelect calls by watching for changes to xColEl options
        const panelRefreshObs = new MutationObserver(() => {
            if (state.columns && state.columns.length > 0) buildDimMetricPanels();
        });
        if (xColEl) panelRefreshObs.observe(xColEl, { childList: true });

    });
})();
