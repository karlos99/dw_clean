{% load static %}
<div class="space-y-4" hx-headers='{"X-CSRFToken": "{{ csrf_token }}"}'>
    {% if error %}
    <div class="p-4 mb-4 text-sm text-red-700 bg-red-100 rounded-lg" role="alert">
        <span class="font-medium">Error loading folders:</span> {{ error }}
    </div>
    {% endif %}

    <!-- Folder Breadcrumbs or Title -->
    <div class="flex items-center justify-between mb-2">
        <div class="text-sm text-gray-500">Folders</div>
    </div>

    {% if shared_queries %}
    <!-- Shared with Me Folder -->
    <div class="folder-group mb-4">
        <details class="group" open>
            <summary
                class="list-none flex items-center justify-between p-2 bg-blue-50 rounded cursor-pointer hover:bg-blue-100">
                <span class="font-medium text-blue-700 flex items-center gap-2">
                    <svg class="w-4 h-4 text-blue-400 group-open:hidden" fill="none" stroke="currentColor"
                        viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z">
                        </path>
                    </svg>
                    <svg class="w-4 h-4 text-blue-600 hidden group-open:block" fill="currentColor" viewBox="0 0 24 24">
                        <path
                            d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z">
                        </path>
                    </svg>
                    Shared with Me
                    <span class="text-xs text-blue-500 font-normal">({{ shared_queries.count }})</span>
                </span>
            </summary>
            <div class="ml-4 mt-2 space-y-1">
                <!-- Shared Queries -->
                {% for item in shared_queries %}
                <div class="group/item hover:bg-blue-50 rounded p-2 flex items-center justify-between">
                    <a href="?saved_query={{ item.query.id }}"
                        class="flex-1 flex items-center gap-2 text-sm text-gray-700">
                        <svg class="w-3 h-3 text-blue-500 flex-shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z">
                            </path>
                        </svg>
                        <span class="truncate">{{ item.query.name }}</span>
                        <span class="text-xs text-gray-400 ml-1">by {{
                            item.query.owner.first_name|default:item.query.owner.email
                            }}</span>
                    </a>
                    <div class="hidden group-hover/item:flex items-center gap-1">
                        {% if item.can_edit %}
                        <button type="button"
                            onclick="showRenameModal({{ item.query.id }}, 'query', '{{ item.query.name|escapejs }}', '{{ item.query.description|default:''|escapejs }}')"
                            class="p-1 text-gray-400 hover:text-blue-600" title="Rename">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                                </path>
                            </svg>
                        </button>
                        {% endif %}
                        <span class="text-xs text-gray-400 px-1" title="Shared by {{ item.query.owner.email }}">
                            <svg class="w-3 h-3 inline" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z">
                                </path>
                            </svg>
                        </span>
                    </div>
                </div>
                {% endfor %}
            </div>
        </details>
    </div>
    {% endif %}

    {% for folder in folders %}
    <div class="folder-group mb-4">
        <!-- Root Folder -->
        <details class="group" {% if folder.folder_type=='USER' %}open{% endif %}>
            <summary
                class="list-none flex items-center justify-between p-2 bg-gray-50 rounded cursor-pointer hover:bg-gray-100">
                <span class="font-medium text-gray-700 flex items-center gap-2">
                    <svg class="w-4 h-4 text-gray-400 group-open:hidden" fill="none" stroke="currentColor"
                        viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                            d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
                    </svg>
                    <svg class="w-4 h-4 text-yellow-500 hidden group-open:block" fill="currentColor"
                        viewBox="0 0 24 24">
                        <path d="M3 7v10a2 2 0 002 2h14a2 2 0 002-2V9a2 2 0 00-2-2h-6l-2-2H5a2 2 0 00-2 2z"></path>
                    </svg>
                    {{ folder.name }}
                </span>
                <div class="flex items-center gap-2">
                    {% if user.is_superuser or user.role.name == "Project Admin" or user.role.name == "District Admin"
                    or folder.folder_type == "USER" and folder.owner == user %}
                    <button type="button" onclick="showCreateFolderModal({{ folder.id }})"
                        class="p-1 text-gray-400 hover:text-blue-600" title="Create Subfolder">
                        <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4">
                            </path>
                        </svg>
                    </button>
                    {% endif %}
                </div>
            </summary>
            <div class="ml-4 mt-2 space-y-1">

                <!-- Saved Queries -->
                {% for query in folder.queries.all %}
                <div class="group/item hover:bg-blue-50 rounded p-2 flex items-center justify-between">
                    <a href="?saved_query={{ query.id }}" class="flex-1 flex items-center gap-2 text-sm text-gray-700">
                        <svg class="w-3 h-3 text-blue-500 flex-shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M9 17v-2m3 2v-4m3 4v-6m2 10H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z">
                            </path>
                        </svg>
                        <span class="truncate">{{ query.name }}</span>
                    </a>
                    <div class="hidden group-hover/item:flex items-center gap-1">
                        <button type="button"
                            onclick="showRenameModal({{ query.id }}, 'query', '{{ query.name|escapejs }}', '{{ query.description|default:''|escapejs }}')"
                            class="p-1 text-gray-400 hover:text-blue-600" title="Rename">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                                </path>
                            </svg>
                        </button>
                        <button type="button"
                            onclick="showShareModal({{ query.id }}, 'query', '{{ query.name|escapejs }}')"
                            class="p-1 text-gray-400 hover:text-green-600" title="Share">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z">
                                </path>
                            </svg>
                        </button>
                        <button type="button" hx-post="{% url 'dataexploration:delete_query' query.id %}"
                            hx-confirm="Are you sure you want to delete '{{ query.name }}'?"
                            hx-target="#modals-container" class="p-1 text-gray-400 hover:text-red-600" title="Delete">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                                </path>
                            </svg>
                        </button>
                    </div>
                </div>
                {% endfor %}

                <!-- Student Lists -->
                {% for list in folder.student_lists.all %}
                <div class="group/item hover:bg-green-50 rounded p-2 flex items-center justify-between">
                    <a href="?student_list={{ list.id }}" class="flex-1 flex items-center gap-2 text-sm text-gray-700">
                        <svg class="w-3 h-3 text-green-500 flex-shrink-0" fill="none" stroke="currentColor"
                            viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z">
                            </path>
                        </svg>
                        <span class="truncate">{{ list.name }}</span>
                    </a>
                    <div class="hidden group-hover/item:flex items-center gap-1">
                        <button type="button"
                            onclick="showRenameModal({{ list.id }}, 'list', '{{ list.name|escapejs }}', '{{ list.description|default:''|escapejs }}')"
                            class="p-1 text-gray-400 hover:text-blue-600" title="Rename">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z">
                                </path>
                            </svg>
                        </button>
                        <button type="button" hx-post="{% url 'dataexploration:delete_student_list' list.id %}"
                            hx-confirm="Are you sure you want to delete '{{ list.name }}'?"
                            hx-target="#modals-container" class="p-1 text-gray-400 hover:text-red-600" title="Delete">
                            <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16">
                                </path>
                            </svg>
                        </button>
                    </div>
                </div>
                {% endfor %}

                {% if not folder.queries.exists and not folder.student_lists.exists %}
                <div class="text-xs text-gray-400 italic p-2">Empty</div>
                {% endif %}
            </div>
        </details>
    </div>
    {% empty %}
    <div class="text-center text-gray-500 text-sm mt-4">
        No folders available.
    </div>
    {% endfor %}
</div>